    - target: {fileID: 15045913467653498, guid: 206f21c683f682c49b7b8eecc73737a1, type: 3}
      propertyPath: dialogueSequence.triggerEventWhenEnding
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 15045913467653498, guid: 206f21c683f682c49b7b8eecc73737a1, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[0].textContent
      value: "\u9738\u9053\u7E3D\u88C1\u5C08\u751F\u5230\u7570\u4E16\u754C\u6253\u602A\u9677\u5165\u5BAE\u9B25\u8207\u537B\u4E0D\u5C0F\u5FC3\u767C\u73FE\u5916\u661F\u4EBA\u9670\u8B00\r\n\u7B2C\u4E00\u7AE0\uFF1A\u6B7B\u8207\u8F49\u751F\r\n\u4ECA\u5929\u7684\u592A\u967D\u683C\u5916\u8000\u773C\u3002\u81F3\u5C11\u5728\u6211\u773C\u88E1\u662F\u9019\u9EBC\u89BA\u5F97\u7684\u3002\u56E0\u70BA\u5728\u6211\u773C\u524D\u9583\u9583\u767C\u5149\u7684\uFF0C\u4E0D\u53EA\u662F\u5929\u7A7A\u4E0A\u7684\u592A\u967D\uFF0C\u9084\u6709\u65E9\u9910\u684C\u4E0A\u90A3\u4E09\u9846\u5192\u8457\u71B1\u6C23\u7684\u6C34\u716E\u86CB\u3002\u662F\u7684\uFF0C\u4E09\u9846\u3002\u4E0D\u662F\u5169\u9846\uFF0C\u4E5F\u4E0D\u662F\u56DB\u9846\uFF0C\u800C\u662F\u7CBE\u6E96\u7684\u4E09\u9846\u3002\u9019\u4E09\u9846\u86CB\u5C31\u50CF\u547D\u904B\u5973\u795E\u89AA\u624B\u64FA\u653E\u7684\u9AB0\u5B50\uFF0C\u8C61\u5FB5\u8457\u6211\u7684\u4EBA\u751F\u5C07\u8981\u767C\u751F\u7FFB\u5929\u8986\u5730\u7684\u8B8A\u5316\u3002\r\n\u6211\u76EF\u8457\u90A3\u4E09\u9846\u86CB\u770B\u4E86\u8DB3\u8DB3\u5341\u4E94\u5206\u9418\u3002\u5148\u770B\u7B2C\u4E00\u9846\uFF0C\u8868\u76AE\u6709\u9EDE\u88C2\u7E2B\uFF0C\u6211\u5FCD\u4E0D\u4F4F\u60F3\uFF1A\u9019\u662F\u4E0D\u662F\u6697\u793A\u6211\u4ECA\u5929\u6703\u9047\u5230\u4EC0\u9EBC\u7834\u788E\u7684\u547D\u904B\uFF1F\u518D\u770B\u7B2C\u4E8C\u9846\uFF0C\u5713\u6EFE\u6EFE\u7684\uFF0C\u50CF\u6975\u4E86\u516C\u53F8\u88E1\u90A3\u500B\u5929\u5929\u5C0D\u6211\u64FA\u81C9\u8272\u7684\u4E3B\u7BA1\u7684\u8166\u888B\uFF0C\u6CB9\u4EAE\u537B\u7A7A\u6D1E\u3002\u6700\u5F8C\u662F\u7B2C\u4E09\u9846\uFF0C\u5B8C\u7F8E\u7121\u7455\uFF0C\u9583\u8000\u8457\u5FAE\u5149\uFF0C\u5F77\u5F7F\u5728\u544A\u8A34\u6211\uFF1A\u300C\u5403\u4E86\u6211\uFF0C\u4F60\u5C07\u6539\u8B8A\u4E16\u754C\u3002\u300D\r\n\u65BC\u662F\u6211\u62FF\u8D77\u4E86\u7B2C\u4E09\u9846\u86CB\uFF0C\u6162\u6162\u525D\u6BBC\uFF0C\u4E00\u9EDE\u4E00\u9EDE\uFF0C\u788E\u5C51\u6389\u5728\u684C\u5B50\u4E0A\uFF0C\u6211\u537B\u4E0D\u6025\u8457\u5403\u3002\u6211\u5728\u60F3\uFF0C\u70BA\u4EC0\u9EBC\u4ECA\u5929\u7684\u86CB\u6BBC\u6BD4\u6628\u5929\u7684\u9084\u8981\u786C\uFF1F\u70BA\u4EC0\u9EBC\u6628\u5929\u6211\u53EA\u716E\u4E86\u5169\u9846\uFF0C\u4ECA\u5929\u537B\u83AB\u540D\u5176\u5999\u5730\u591A\u716E\u4E86\u4E00\u9846\uFF1F\u662F\u4E0D\u662F\u51A5\u51A5\u4E2D\u6709\u4EC0\u9EBC\u529B\u91CF\u5728\u727D\u5F15\u8457\u6211\uFF1F\u662F\u4E0D\u662F\u547D\u904B\u5728\u6697\u793A\u6211\u4EC0\u9EBC\uFF1F\r\n\u5C31\u5728\u6211\u525D\u5230\u4E00\u534A\uFF0C\u9084\u6C92\u5403\u4E0B\u53BB\u7684\u6642\u5019\uFF0C\u9580\u5916\u50B3\u4F86\u4E00\u8072\u8F5F\u9CF4\u3002\u90A3\u662F\u4E00\u8F1B\u5361\u8ECA\u3002\u6E96\u78BA\u4F86\u8AAA\uFF0C\u662F\u4E00\u8F1B\u6C92\u6709\u4EBA\u99D5\u99DB\u3001\u537B\u81EA\u5DF1\u9AD8\u901F\u885D\u904E\u4F86\u7684\u5361\u8ECA\u3002\u6211\u751A\u81F3\u9084\u770B\u898B\u8ECA\u982D\u8CBC\u8457\u4E00\u5F35\u7D19\u689D\uFF0C\u4E0A\u9762\u5BEB\u8457\u300C\u7570\u4E16\u754C\u5FEB\u905E\uFF0C\u5C08\u9001\u4E3B\u89D2\u300D\u3002\u6211\u4E00\u6642\u6123\u4F4F\uFF0C\u5FC3\u60F3\u9019\u662F\u4E0D\u662F\u60E1\u4F5C\u5287\u3002\u4F46\u4E0B\u4E00\u79D2\uFF0C\u6211\u5C31\u6C92\u5F97\u60F3\u4E86\uFF0C\u56E0\u70BA\u5361\u8ECA\u76F4\u76F4\u885D\u9032\u4F86\uFF0C\u628A\u6211\u548C\u4E09\u9846\u6C34\u716E\u86CB\u4E00\u4F75\u5E36\u8D70\u3002\r\n\u6211\u6B7B\u4E86\u3002\r\n\u9019\u662F\u6BEB\u7121\u61F8\u5FF5\u7684\u4E8B\u5BE6\u3002\u6211\u751A\u81F3\u80FD\u6E05\u695A\u611F\u53D7\u5230\u81EA\u5DF1\u8EAB\u9AD4\u88AB\u649E\u98DB\u7684\u90A3\u4E00\u523B\uFF0C\u53E3\u4E2D\u9084\u54AC\u8457\u534A\u9846\u86CB\u9EC3\u3002\u86CB\u9EC3\u7684\u5473\u9053\u6DF7\u5408\u8457\u8840\u8165\u5473\uFF0C\u7ADF\u7136\u610F\u5916\u7684\u5947\u5999\u3002\u90A3\u4E00\u77AC\u9593\uFF0C\u6211\u5FC3\u88E1\u53EA\u60F3\u8457\uFF1A\u300C\u597D\u6D6A\u8CBB\u554A\uFF0C\u53E6\u5916\u5169\u9846\u9084\u6C92\u5403\u5462\u3002\u300D\r\n\u63A5\u8457\uFF0C\u6211\u7684\u773C\u524D\u4E00\u7247\u9ED1\u6697\uFF0C\u9ED1\u5F97\u5C31\u50CF\u505C\u96FB\u5F8C\u7684\u51B0\u7BB1\u3002\u6211\u5728\u9ED1\u6697\u4E2D\u6F02\u6D6E\uFF0C\u8033\u908A\u50B3\u4F86\u4E00\u500B\u8072\u97F3\uFF0C\u65E2\u50CF\u5973\u795E\uFF0C\u53C8\u50CF\u96FB\u8996\u8CFC\u7269\u4E3B\u6301\u4EBA\u3002\r\n\u300C\u89AA\u611B\u7684\u9867\u5BA2\u60A8\u597D\uFF0C\u606D\u559C\u60A8\u7372\u5F97\u8F49\u751F\u670D\u52D9\uFF01\u6211\u5011\u7684\u65B9\u6848\u5305\u62EC\uFF1AA\u3001\u8F49\u751F\u70BA\u9B54\u6CD5\u738B\u570B\u7684\u5929\u9078\u52C7\u8005\uFF1BB\u3001\u8F49\u751F\u6210\u9738\u9053\u7E3D\u88C1\u7684\u5152\u5B50\uFF1BC\u3001\u8F49\u751F\u6210\u5BAE\u5EF7\u5C0F\u5B98\u4E4B\u5B50\uFF0C\u4F46\u6703\u610F\u5916\u64C1\u6709\u5104\u842C\u8CC7\u7522\uFF1B\u8ACB\u554F\u60A8\u8981\u9078\u54EA\u4E00\u500B\u5462\uFF1F\u300D\r\n\u6211\u6123\u4E86\u6123\uFF0C\u5FC3\u60F3\u9019\u4E0D\u662F\u592A\u5212\u7B97\u4E86\u55CE\uFF1F\u4E00\u822C\u4EBA\u8F49\u751F\u53EA\u6703\u6709\u4E00\u500B\u9078\u9805\uFF0C\u6211\u7ADF\u7136\u4E00\u6B21\u62FF\u5230\u4E09\u500B\u3002\u65BC\u662F\u6211\u5927\u8072\u56DE\u7B54\uFF1A\u300C\u6211\u5168\u90FD\u8981\uFF01\u300D\r\n\u6C89\u9ED8\u4E86\u4E00\u79D2\uFF0C\u7136\u5F8C\u90A3\u8072\u97F3\u7B11\u4E86\uFF1A\u300C\u54C8\u54C8\uFF0C\u592A\u8CAA\u5FC3\u7684\u9748\u9B42\u554A\uFF0C\u4F46\u6211\u5011\u516C\u53F8\u6700\u559C\u6B61\u7684\u5C31\u662F\u8CAA\u5FC3\u3002\u65E2\u7136\u5982\u6B64\uFF0C\u4F60\u5C31\u4E09\u500B\u8EAB\u4EFD\u540C\u6642\u64C1\u6709\u5427\uFF01\u300D\r\n\u6211\u9084\u4F86\u4E0D\u53CA\u9A5A\u547C\uFF0C\u773C\u524D\u7684\u9ED1\u6697\u5C31\u958B\u59CB\u626D\u66F2\uFF0C\u50CF\u8001\u820A\u96FB\u8996\u88AB\u4EBA\u62FC\u547D\u8F49\u983B\u9053\u4E00\u6A23\u3002\u63A5\u8457\uFF0C\u6211\u775C\u958B\u773C\u775B\uFF0C\u767C\u73FE\u81EA\u5DF1\u8EBA\u5728\u4E00\u5F35\u96D5\u82B1\u7684\u6728\u5E8A\u4E0A\uFF0C\u65C1\u908A\u6709\u500B\u5B0C\u4FCF\u7684\u4F8D\u5973\u6B63\u62FF\u8457\u71B1\u6BDB\u5DFE\uFF0C\u4E00\u908A\u558A\uFF1A\u300C\u5C11\u723A\uFF01\u5C11\u723A\uFF01\u60A8\u7D42\u65BC\u9192\u4E86\uFF01\u300D\r\n\u6211\u6123\u4F4F\u4E86\u3002\u56E0\u70BA\u5C31\u5728\u540C\u6642\uFF0C\u6211\u7684\u8166\u6D77\u88E1\u4E5F\u97FF\u8D77\u53E6\u4E00\u500B\u8072\u97F3\uFF1A\u300C\u8463\u4E8B\u9577\uFF0C\u4ECA\u5929\u7684\u80A1\u6771\u5927\u6703\u99AC\u4E0A\u958B\u59CB\uFF0C\u8ACB\u60A8\u8D95\u5FEB\u63DB\u4E0A\u897F\u88DD\uFF01\u300D\r\n\u800C\u5728\u89D2\u843D\u88E1\uFF0C\u9084\u6709\u500B\u592A\u76E3\u6A21\u6A23\u7684\u4EBA\u8DEA\u8457\u8AAA\uFF1A\u300C\u555F\u7A1F\u5C11\u723A\uFF0C\u5BAE\u88E1\u7684\u8CB4\u4EBA\u5011\u6B63\u5728\u7B49\u60A8\u8D74\u5BB4\uFF01\u300D\r\n\u4EC0\u9EBC\u60C5\u6CC1\uFF1F\u6211\u4F4E\u982D\u4E00\u770B\uFF0C\u767C\u73FE\u81EA\u5DF1\u8EAB\u4E0A\u7ADF\u7136\u540C\u6642\u7A7F\u8457\u53E4\u4EE3\u7D72\u7DA2\u9577\u888D\u3001\u73FE\u4EE3\u540D\u724C\u897F\u88DD\uFF0C\u4EE5\u53CA\u67D0\u7A2E\u50CF\u52C7\u8005\u88DD\u5099\u7684\u5947\u602A\u76D4\u7532\u3002\u4E09\u7A2E\u8EAB\u4EFD\uFF0C\u4E09\u7A2E\u8CAC\u4EFB\uFF0C\u4E09\u500D\u7684\u9EBB\u7169\u3002\r\n\u300C\u9019\u4E0D\u662F\u9B27\u8457\u73A9\u7684\u5427\u2026\u2026\u300D\u6211\u5583\u5583\u81EA\u8A9E\u3002\r\n\u4F8D\u5973\u4E00\u81C9\u6FC0\u52D5\uFF1A\u300C\u5C11\u723A\uFF0C\u60A8\u4E0D\u8A18\u5F97\u4E86\u55CE\uFF1F\u60A8\u662F\u6211\u5011\u738B\u671D\u6700\u5E74\u8F15\u7684\u5C0F\u5B98\u4E4B\u5B50\uFF0C\u9084\u662F\u9B54\u6CD5\u52C7\u8005\uFF0C\u66F4\u662F\u9738\u9053\u7E3D\u88C1\u552F\u4E00\u7684\u7E7C\u627F\u4EBA\uFF01\u300D\r\n\u6211\u6C89\u9ED8\u3002\r\n\u6211\u89BA\u5F97\u982D\u5F88\u75DB\u3002\r\n\u75DB\u5F97\u50CF\u6628\u5929\u5FD8\u4E86\u62D4\u6389\u7684\u96FB\u934B\u63D2\u982D\u3002\r\n\u7136\u800C\u66F4\u75DB\u7684\u662F\u2014\u2014\u6211\u7A81\u7136\u60F3\u8D77\u4F86\uFF0C\u90A3\u4E09\u9846\u6C34\u716E\u86CB\uFF0C\u6211\u53EA\u5403\u4E86\u4E00\u534A\u3002\u9019\u4E0B\u53EF\u600E\u9EBC\u8FA6\u554A\uFF1F\r\n\u7B2C\u4E8C\u7AE0\uFF1A\u7570\u4E16\u754C\u65E5\u5E38\r\n\u6211\u9192\u4F86\u4E86\u3002\r\n\u6E96\u78BA\u4F86\u8AAA\uFF0C\u662F\u5728\u4E00\u5F35\u67D4\u8EDF\u5230\u904E\u5206\u7684\u5E8A\u4E0A\u9192\u4F86\u3002\u90A3\u5E8A\u7684\u8EDF\u5EA6\u50CF\u6975\u4E86\u6211\u5728\u73FE\u4EE3\u6642\u4EE3\u53BB\u4E94\u661F\u7D1A\u98EF\u5E97\u6642\u8E29\u5230\u7684\u7FBD\u7D68\u5E8A\u588A\uFF0C\u53C8\u597D\u50CF\u662F\u53E4\u4EE3\u50B3\u8AAA\u4E2D\u7528\u5929\u9D5D\u7D68\u5806\u51FA\u4F86\u7684\u5BAE\u5EF7\u69BB\u69BB\u7C73\u3002\u7E3D\u4E4B\uFF0C\u8EDF\u5F97\u6211\u9023\u7FFB\u8EAB\u90FD\u89BA\u5F97\u81EA\u5DF1\u50CF\u6389\u9032\u4E86\u96F2\u7AEF\u3002\r\n\u6211\u63C9\u4E86\u63C9\u773C\u775B\uFF0C\u62C9\u958B\u7A97\u7C3E\u3002\r\n\u554A\uFF0C\u592A\u967D\u3002\r\n\u91D1\u5149\u9583\u9583\uFF0C\u76F4\u5C04\u9032\u6211\u7684\u623F\u9593\uFF0C\u7167\u4EAE\u4E86\u96D5\u82B1\u7684\u5E8A\u67F1\u3001\u5730\u6BEF\u4E0A\u7684\u91D1\u7DDA\uFF0C\u9084\u6709\u684C\u5B50\u4E0A\u64FA\u8457\u7684\u90A3\u4E00\u76E4\u6C34\u679C\u3002\u6C34\u679C\u88E1\u6709\u8461\u8404\uFF0C\u7D2B\u5F97\u767C\u4EAE\uFF1B\u6709\u860B\u679C\uFF0C\u7D05\u5F97\u50CF\u5F8C\u5BAE\u5A18\u5A18\u7684\u5634\u5507\uFF1B\u9084\u6709\u4E00\u9846\u6211\u53EB\u4E0D\u51FA\u540D\u5B57\u7684\u7570\u4E16\u754C\u6C34\u679C\uFF0C\u5916\u76AE\u9577\u6EFF\u523A\uFF0C\u770B\u8D77\u4F86\u50CF\u523A\u875F\u3002\u4F46\u6211\u5FCD\u4E0D\u4F4F\u770B\u4E86\u4E09\u904D\u3002\u7B2C\u4E00\u904D\u770B\u662F\u89BA\u5F97\u771F\u6F02\u4EAE\uFF0C\u7B2C\u4E8C\u904D\u770B\u662F\u61F7\u7591\u81EA\u5DF1\u773C\u82B1\uFF0C\u7B2C\u4E09\u904D\u770B\u5247\u55AE\u7D14\u56E0\u70BA\u6211\u60F3\u518D\u770B\u4E00\u6B21\u3002\u6700\u5F8C\u6211\u6C7A\u5B9A\u5403\u4E0B\u4E00\u9846\u8D85\u5927\u751C\u74DC\uFF0C\u4F5C\u70BA\u4ECA\u5929\u7B2C\u4E00\u6B21\u4F86\u5230\u7570\u4E16\u754C\u7684\u65E9\u9910\u3002\r\n\u6211\u8D70\u5230\u7A97\u524D\u3002\u63A8\u958B\u7A97\uFF0C\u9CE5\u9CF4\u8072\u50B3\u4F86\u3002\r\n\u300C\u557E\u557E\u557E\u2014\u2014\u300D\r\n\u9019\u8072\u97F3\u6E05\u8106\u5F97\u50CF\u624B\u6A5F\u9234\u8072\u3002\u6211\u5FCD\u4E0D\u4F4F\u91CD\u8907\u807D\u4E86\u4E09\u6B21\u3002\u7B2C\u4E00\u6B21\u89BA\u5F97\u6085\u8033\uFF0C\u7B2C\u4E8C\u6B21\u89BA\u5F97\u6709\u9EDE\u5435\uFF0C\u7B2C\u4E09\u6B21\u958B\u59CB\u89BA\u5F97\u9019\u9CE5\u662F\u4E0D\u662F\u6545\u610F\u5728\u6311\u91C1\u6211\u3002\r\n\u5C31\u5728\u6211\u6C89\u8FF7\u65BC\u548C\u9CE5\u5152\u7684\u5C0D\u8996\u6642\uFF0C\u9580\u5916\u50B3\u4F86\u4E00\u9663\u8173\u6B65\u8072\u3002\u7DCA\u63A5\u8457\uFF0C\u4F8D\u5973\u963F\u82B1\u63A8\u9580\u9032\u4F86\u3002\r\n\u300C\u5C11\u723A\uFF01\u60A8\u8A72\u8D77\u5E8A\u4E86\uFF0C\u65E9\u9910\u5DF2\u7D93\u6E96\u5099\u597D\u4E86\uFF01\u300D\r\n\u6211\u6123\u4E86\u6123\u3002\u65E9\u9910\uFF1F\u6211\u6700\u559C\u6B61\u7684\u8A5E\u3002\r\n\u6211\u7ACB\u523B\u5750\u5230\u684C\u524D\u3002\u684C\u4E0A\u64FA\u6EFF\u4E86\u98DF\u7269\uFF1A\u6709\u5192\u8457\u71B1\u6C23\u7684\u9EB5\u5305\uFF0C\u9EC3\u6F84\u6F84\u7684\u5976\u6CB9\uFF0C\u9999\u5674\u5674\u7684\u57F9\u6839\uFF0C\u9084\u6709\u5E7E\u9846\u719F\u6089\u7684\u6C34\u716E\u86CB\u3002\u662F\u7684\uFF0C\u53C8\u662F\u6C34\u716E\u86CB\u3002\u9019\u6B21\u4E0D\u662F\u4E09\u9846\uFF0C\u800C\u662F\u4E94\u9846\uFF0C\u6574\u6574\u4E94\u9846\u3002\r\n\u6211\u77AA\u5927\u773C\u775B\u3002\u4E94\u9846\u86CB\u6392\u6210\u4E00\u6392\uFF0C\u50CF\u4E94\u500B\u5019\u9078\u4EBA\u7AD9\u5728\u6211\u9762\u524D\uFF0C\u7B49\u8457\u6211\u6311\u9078\u3002\r\n\u6211\u5148\u62FF\u8D77\u7B2C\u4E00\u9846\uFF0C\u525D\u958B\uFF0C\u805E\u4E00\u805E\uFF0C\u55EF\uFF0C\u548C\u6628\u5929\u4E00\u6A23\u3002\u7136\u5F8C\u6211\u53C8\u653E\u4E0B\u3002\u518D\u62FF\u7B2C\u4E8C\u9846\uFF0C\u525D\u958B\uFF0C\u54AC\u4E00\u53E3\uFF0C\u53C8\u653E\u4E0B\u3002\u63A5\u8457\u6211\u628A\u7B2C\u4E09\u9846\u3001\u7B2C\u56DB\u9846\u3001\u7B2C\u4E94\u9846\u90FD\u91CD\u8907\u9019\u6A23\u7684\u52D5\u4F5C\u3002\u7D50\u679C\u684C\u4E0A\u6392\u4E86\u4E00\u6574\u6392\u525D\u4E86\u4E00\u534A\u7684\u86CB\uFF0C\u770B\u8D77\u4F86\u5C31\u50CF\u4E00\u5834\u96DE\u86CB\u5927\u6703\u3002\r\n\u300C\u5C11\u723A\uFF0C\u60A8\u600E\u9EBC\u4E0D\u5403\u5B8C\u5462\uFF1F\u300D\u963F\u82B1\u7591\u60D1\u5730\u554F\u3002\r\n\u6211\u6B63\u8272\u56DE\u7B54\uFF1A\u300C\u4E0D\u884C\uFF0C\u9019\u6A23\u624D\u80FD\u9AD4\u73FE\u51FA\u6211\u4F5C\u70BA\u9738\u9053\u7E3D\u88C1\u7684\u6C23\u8CEA\u3002\u7E3D\u88C1\u5F9E\u4F86\u4E0D\u6703\u4E00\u6B21\u5403\u5B8C\u4E00\u9846\u86CB\uFF0C\u56E0\u70BA\u7E3D\u88C1\u8981\u8B93\u6240\u6709\u86CB\u90FD\u89BA\u5F97\u81EA\u5DF1\u88AB\u91CD\u8996\u3002\u300D\r\n\u963F\u82B1\u807D\u4E86\u4F3C\u61C2\u975E\u61C2\uFF0C\u9084\u50BB\u50BB\u5730\u9EDE\u982D\u3002\r\n\u5C31\u5728\u9019\u6642\uFF0C\u53E6\u4E00\u500B\u592A\u76E3\u6A21\u6A23\u7684\u4EBA\u95D6\u4E86\u9032\u4F86\uFF1A\u300C\u5C11\u723A\uFF01\u5BAE\u88E1\u7684\u6DD1\u5983\u5A18\u5A18\u5429\u5490\uFF0C\u8981\u60A8\u4ECA\u65E5\u52D9\u5FC5\u524D\u5F80\u5FA1\u82B1\u5712\u8D74\u5BB4\uFF01\u5426\u5247\u5979\u8981\u7F70\u5EDA\u623F\u4E0D\u51C6\u7D66\u60A8\u6E96\u5099\u8336\u8449\u86CB\uFF01\u300D\r\n\u6211\u6123\u4F4F\u3002\u8336\u8449\u86CB\uFF1F\u539F\u4F86\u5BAE\u9B25\u7684\u6838\u5FC3\u662F\u8336\u8449\u86CB\uFF1F\r\n\u6211\u9084\u6C92\u56DE\u7B54\uFF0C\u8166\u6D77\u88E1\u537B\u50B3\u4F86\u53E6\u4E00\u500B\u8072\u97F3\uFF1A\u300C\u8463\u4E8B\u9577\uFF0C\u60A8\u7684\u516C\u53F8\u4ECA\u5929\u8981\u7C3D\u4E00\u4EFD\u5E7E\u5341\u5104\u7684\u5408\u7D04\uFF0C\u5982\u679C\u60A8\u4E0D\u51FA\u5E2D\uFF0C\u6295\u8CC7\u4EBA\u6703\u4EE5\u70BA\u60A8\u5728\u88DD\u795E\u5F04\u9B3C\u3002\u300D\r\n\u540C\u4E00\u6642\u9593\uFF0C\u6211\u7684\u52C7\u8005\u7CFB\u7D71\u4E5F\u8E66\u51FA\u63D0\u793A\uFF1A\u300C\u52C7\u8005\u5927\u4EBA\uFF0C\u9B54\u738B\u8ECD\u5373\u5C07\u653B\u57CE\uFF0C\u8ACB\u60A8\u7ACB\u523B\u53EC\u96C6\u58EB\u5175\uFF01\u300D\r\n\u4E09\u500B\u8EAB\u4EFD\uFF0C\u4E09\u500B\u4E8B\u4EF6\uFF0C\u4E09\u500D\u7684\u9EBB\u7169\u3002\r\n\u6211\u6293\u8D77\u4E00\u9846\u86CB\uFF0C\u72E0\u72E0\u54AC\u4E86\u4E00\u53E3\uFF0C\u7136\u5F8C\u4E00\u908A\u56BC\u4E00\u908A\u5927\u558A\uFF1A\u300C\u6211\u5168\u90FD\u8981\uFF01\u300D\r\n\u963F\u82B1\u88AB\u6211\u5687\u4E86\u4E00\u8DF3\uFF0C\u592A\u76E3\u6123\u4F4F\u4E86\uFF0C\u8166\u6D77\u88E1\u7684\u52A9\u7406\u4E5F\u6C89\u9ED8\u4E86\u4E00\u79D2\u3002\r\n\u300C\u5C11\u723A\uFF0C\u60A8\u9019\u662F\u2026\u2026\u300D\r\n\u300C\u6C92\u4EC0\u9EBC\uFF0C\u6211\u53EA\u662F\u89BA\u5F97\u65E9\u9910\u7684\u86CB\u7279\u5225\u9999\u3002\u300D\u6211\u5047\u88DD\u82E5\u7121\u5176\u4E8B\uFF0C\u7E7C\u7E8C\u54AC\u8457\u86CB\u9EC3\u3002\r\n\u53EF\u5176\u5BE6\uFF0C\u6211\u5FC3\u88E1\u5DF2\u7D93\u96B1\u96B1\u660E\u767D\uFF1A\u5F9E\u4ECA\u4EE5\u5F8C\uFF0C\u6211\u7684\u65E5\u5E38\u751F\u6D3B\uFF0C\u5C07\u6703\u662F\u7121\u7AAE\u7121\u76E1\u7684\u65E9\u9910\u3001\u7121\u7AAE\u7121\u76E1\u7684\u6703\u8B70\u3001\u7121\u7AAE\u7121\u76E1\u7684\u5BAE\u9B25\u3002\r\n\u9019\u7570\u4E16\u754C\u7684\u4E00\u5929\uFF0C\u5C31\u9019\u9EBC\u958B\u59CB\u4E86\u3002\r\n\u7B2C\u4E09\u7AE0\uFF1A\u9738\u9053\u7E3D\u88C1\u767B\u5834\r\n\u6211\u672C\u4F86\u4EE5\u70BA\uFF0C\u5728\u7570\u4E16\u754C\u7684\u65E5\u5B50\uFF0C\u6700\u591A\u5C31\u662F\u5403\u9EDE\u65E9\u9910\u3001\u807D\u807D\u9CE5\u53EB\u3001\u5076\u723E\u61C9\u4ED8\u5BAE\u88E1\u7684\u5A18\u5A18\u3002\u4F46\u6211\u932F\u4E86\uFF0C\u5927\u932F\u7279\u932F\u3002\u56E0\u70BA\u5C31\u5728\u6211\u9084\u5728\u6399\u624E\u8981\u4E0D\u8981\u628A\u5269\u4E0B\u90A3\u9846\u6C34\u716E\u86CB\u5403\u6389\u7684\u6642\u5019\uFF0C\u4E00\u7FA4\u4EBA\u885D\u4E86\u9032\u4F86\u3002\r\n\u9996\u5148\u662F\u4F8D\u5973\u963F\u82B1\uFF0C\u5979\u4E00\u908A\u5598\u6C23\u4E00\u908A\u558A\uFF1A\u300C\u5C11\u723A\uFF01\u5FEB\uFF0C\u5FEB\u6E96\u5099\uFF01\u6DD1\u5983\u5A18\u5A18\u5DF2\u7D93\u5728\u5FA1\u82B1\u5712\u7B49\u5019\u60A8\uFF01\u300D\r\n\u7136\u5F8C\u662F\u592A\u76E3\uFF0C\u4ED6\u8072\u97F3\u5C16\u92B3\u5F97\u50CF\u7834\u97F3\u7684\u5587\u53ED\uFF1A\u300C\u5C11\u723A\uFF0C\u842C\u6B72\u723A\u89AA\u53E3\u8AAA\uFF0C\u4ECA\u65E5\u5BB4\u6703\u82E5\u60A8\u4E0D\u5230\uFF0C\u5168\u5BAE\u4E0A\u4E0B\u90FD\u5F97\u9023\u5750\uFF01\u300D\r\n\u6700\u5F8C\u662F\u8166\u6D77\u88E1\u7684\u52A9\u7406\u5C0F\u738B\uFF0C\u8A9E\u6C23\u56B4\u8085\uFF1A\u300C\u8463\u4E8B\u9577\uFF0C\u5225\u518D\u62D6\u5EF6\u4E86\uFF01\u80A1\u6771\u5927\u6703\u5DF2\u7D93\u958B\u59CB\u4E09\u5206\u9418\u4E86\uFF0C\u60A8\u518D\u4E0D\u51FA\u73FE\uFF0C\u80A1\u50F9\u5C31\u8981\u66B4\u8DCC\u4E86\uFF01\u300D\r\n\u4E09\u500B\u50AC\u4FC3\u540C\u6642\u97FF\u8D77\uFF0C\u6211\u89BA\u5F97\u6211\u7684\u8166\u888B\u8981\u7206\u70B8\u3002\r\n\u300C\u5B89\u975C\uFF01\u300D\u6211\u62CD\u684C\u5B50\u3002\r\n\u684C\u5B50\u4E0A\u7684\u6C34\u716E\u86CB\u986B\u4E86\u4E00\u4E0B\uFF0C\u5DEE\u9EDE\u6EFE\u4E0B\u4F86\u3002\u6211\u7ACB\u523B\u4F38\u624B\u6276\u4F4F\uFF0C\u5FC3\u60F3\uFF1A\u9084\u597D\uFF0C\u86CB\u6C92\u4E8B\uFF0C\u8981\u4E0D\u7136\u6211\u4ECA\u5929\u5C31\u6C92\u5FC3\u60C5\u7576\u4EC0\u9EBC\u7E3D\u88C1\u4E86\u3002\r\n\u6211\u6DF1\u5438\u4E00\u53E3\u6C23\uFF0C\u52AA\u529B\u5C55\u73FE\u51FA\u4E00\u7A2E\u7E3D\u88C1\u8A72\u6709\u7684\u51B7\u9177\u3002\u65BC\u662F\u6211\u7DE9\u7DE9\u62AC\u8D77\u982D\uFF0C\u7528\u4E00\u7A2E\u4F4E\u6C89\u7684\u8072\u97F3\u8AAA\uFF1A\u300C\u5E36\u8DEF\u5427\u3002\u300D\r\n\u4F8D\u5973\u548C\u592A\u76E3\u5C0D\u8996\u4E00\u773C\uFF0C\u7ACB\u523B\u9EDE\u982D\u3002\u963F\u82B1\u5C0F\u8DD1\u6B65\u8D70\u5728\u524D\u9762\uFF0C\u592A\u76E3\u5728\u65C1\u908A\u5F4E\u8457\u8170\u9818\u8DEF\uFF0C\u800C\u6211\u5247\u4E00\u908A\u8D70\u4E00\u908A\u807D\u8166\u6D77\u88E1\u52A9\u7406\u7684\u7C21\u5831\u3002\r\n\u300C\u8463\u4E8B\u9577\uFF0C\u4ECA\u5929\u7684\u8B70\u984C\u6709\u4E09\u500B\uFF1A\u4E00\uFF0C\u8DDF\u65E5\u672C\u4F01\u696D\u7C3D\u8A02\u5408\u4F5C\u5951\u7D04\uFF1B\u4E8C\uFF0C\u88C1\u64A4\u4E09\u767E\u540D\u54E1\u5DE5\uFF1B\u4E09\uFF0C\u5BA3\u5E03\u60A8\u8981\u7D50\u5A5A\u3002\u300D\r\n\u300C\u7D50\u5A5A\uFF1F\u300D\u6211\u5DEE\u9EDE\u7D46\u4E86\u4E00\u4E0B\u8173\u3002\r\n\u300C\u662F\u7684\uFF0C\u8463\u4E8B\u9577\u3002\u70BA\u4E86\u7A69\u5B9A\u80A1\u50F9\uFF0C\u96C6\u5718\u6C7A\u5B9A\u66FF\u60A8\u5B89\u6392\u4E00\u5834\u4E16\u7D00\u5A5A\u79AE\u3002\u65B0\u5A18\u4EBA\u9078\u662F\u2026\u2026\u300D\u52A9\u7406\u505C\u9813\u4E86\u4E00\u4E0B\uFF0C\u300C\u2026\u2026\u9084\u4E0D\u78BA\u5B9A\uFF0C\u4F46\u5019\u9078\u540D\u55AE\u88E1\u6709\u4E09\u767E\u591A\u4EBA\u3002\u300D\r\n\u6211\u6C89\u9ED8\u3002\u4E09\u767E\u4EBA\uFF1F\u9019\u4E5F\u592A\u5EB8\u4FD7\u4E86\u5427\u3002\r\n\u5C31\u5728\u9019\u6642\uFF0C\u6211\u5DF2\u7D93\u88AB\u5E36\u5230\u5FA1\u82B1\u5712\u3002\u9019\u5EA7\u82B1\u5712\u5927\u5F97\u9A5A\u4EBA\uFF0C\u88E1\u9762\u7A2E\u6EFF\u4E86\u73AB\u7470\u3001\u7261\u4E39\u3001\u5947\u602A\u7684\u85CD\u8272\u5927\u8611\u83C7\u3002\u4E2D\u592E\u92EA\u8457\u7D05\u6BEF\uFF0C\u6DD1\u5983\u5A18\u5A18\u6B63\u7AEF\u5750\u5728\u91D1\u6905\u4E0A\u3002\u5979\u8863\u8896\u4E00\u7529\uFF0C\u8072\u97F3\u51B7\u51B7\u5730\u8AAA\uFF1A\u300C\u5C0F\u5C11\u723A\uFF0C\u8B93\u672C\u5BAE\u4E45\u7B49\u4E86\u3002\u300D\r\n\u6211\u5FC3\u60F3\uFF1A\u9019\u8A9E\u6C23\uFF0C\u7C21\u76F4\u8DDF\u6211\u524D\u4E16\u516C\u53F8\u88E1\u90A3\u500B\u8001\u95C6\u5A18\u4E00\u6A21\u4E00\u6A23\u3002\r\n\u6211\u9084\u6C92\u56DE\u7B54\uFF0C\u8166\u6D77\u88E1\u7684\u52A9\u7406\u53C8\u63D2\u5634\u4E86\uFF1A\u300C\u8463\u4E8B\u9577\uFF0C\u60A8\u5FC5\u9808\u7ACB\u523B\u5728\u5927\u6703\u4E0A\u767C\u8868\u9738\u6C23\u5BA3\u8A00\uFF0C\u5426\u5247\u6295\u8CC7\u4EBA\u6703\u5931\u53BB\u4FE1\u5FC3\uFF01\u300D\r\n\u65BC\u662F\u6211\u540C\u6642\u9762\u5C0D\u5169\u908A\u7684\u4EBA\u7FA4\u2014\u2014\u4E00\u908A\u662F\u53E4\u4EE3\u5BAE\u5EF7\u7684\u5983\u5B2A\u3001\u592A\u76E3\u3001\u4F8D\u5973\uFF0C\u53E6\u4E00\u908A\u662F\u73FE\u4EE3\u5546\u754C\u7684\u5927\u8001\u95C6\u3001\u80A1\u6771\u3001\u5A92\u9AD4\u3002\r\n\u6211\u6DF1\u5438\u4E00\u53E3\u6C23\uFF0C\u7136\u5F8C\u731B\u5730\u62CD\u684C\u5B50\uFF08\u9019\u6B21\u62CD\u7684\u662F\u5FA1\u82B1\u5712\u88E1\u7684\u9577\u684C\uFF09\u3002\r\n\u300C\u807D\u8457\uFF01\u300D\u6211\u5927\u558A\u3002\r\n\u5168\u5834\u5B89\u975C\u3002\u82B1\u5712\u88E1\u7684\u9CE5\u4E5F\u4E0D\u53EB\u4E86\uFF0C\u8166\u6D77\u88E1\u7684\u52A9\u7406\u4E5F\u9589\u5634\u4E86\u3002\r\n\u6211\u7528\u76E1\u5168\u529B\uFF0C\u628A\u8072\u97F3\u58D3\u4F4E\uFF0C\u51B7\u51B7\u5730\u8AAA\uFF1A\u300C\u5F9E\u4ECA\u5929\u958B\u59CB\u2014\u2014\u4F60\u5011\uFF0C\u90FD\u662F\u6211\u7684\u4EBA\uFF01\u300D\r\n\u9019\u53E5\u8A71\u4E00\u51FA\u4F86\uFF0C\u6574\u500B\u5834\u9762\u70B8\u4E86\u3002\r\n\u5BAE\u88E1\u7684\u5B2A\u5983\u5011\u4E00\u500B\u500B\u5B0C\u5598\u9023\u9023\uFF0C\u751A\u81F3\u6709\u4EBA\u7576\u5834\u6688\u5012\uFF1A\u300C\u5C11\u723A\u592A\u9738\u6C23\u4E86\uFF01\u300D\r\n\u80A1\u6771\u5011\u4E5F\u760B\u72C2\u9F13\u638C\uFF1A\u300C\u8463\u4E8B\u9577\u679C\u7136\u4E0D\u6127\u662F\u9738\u9053\u7E3D\u88C1\uFF01\u300D\r\n\u9023\u90A3\u96BB\u525B\u525B\u5728\u7A97\u5916\u5435\u6211\u7684\u9CE5\uFF0C\u4E5F\u300C\u557E\u300D\u4E86\u4E00\u8072\uFF0C\u597D\u50CF\u5728\u9644\u548C\u6211\u3002\r\n\u6211\u5FC3\u88E1\u5F97\u610F\uFF0C\u4F46\u8868\u9762\u4F9D\u820A\u51B7\u9177\uFF0C\u8F15\u8F15\u62FF\u8D77\u684C\u4E0A\u7684\u8336\u676F\uFF0C\u6162\u6162\u559D\u4E86\u4E00\u53E3\u3002\u5176\u5BE6\u88E1\u9762\u4EC0\u9EBC\u90FD\u6C92\u6709\uFF0C\u4F46\u6211\u559D\u5F97\u5F88\u6709\u6C23\u52E2\u3002\r\n\u6DD1\u5983\u5A18\u5A18\u5FFD\u7136\u7AD9\u8D77\u4F86\uFF0C\u8D70\u5230\u6211\u9762\u524D\uFF0C\u4FEF\u8EAB\u8CBC\u8FD1\u6211\u7684\u8033\u6735\uFF0C\u8072\u97F3\u5B0C\u5A9A\u537B\u5E36\u8457\u5A01\u8105\uFF1A\u300C\u5C11\u723A\uFF0C\u60A8\u65E2\u7136\u8AAA\u6211\u5011\u90FD\u662F\u60A8\u7684\u4EBA\uFF0C\u90A3\u662F\u4E0D\u662F\u4EE3\u8868\u2026\u2026\u9023\u672C\u5BAE\u4E5F\u8981\u807D\u60A8\u7684\uFF1F\u300D\r\n\u6211\u4E00\u6123\uFF0C\u8166\u6D77\u88E1\u7684\u52A9\u7406\u537B\u5728\u540C\u6642\u558A\u9053\uFF1A\u300C\u8463\u4E8B\u9577\uFF0C\u6295\u8CC7\u4EBA\u60F3\u77E5\u9053\uFF0C\u60A8\u6703\u4E0D\u6703\u5A36\u4E0B\u9019\u4F4D\u7F8E\u9E97\u7684\u6DD1\u5983\uFF01\u300D\r\n\u6211\u984D\u982D\u76F4\u5192\u6C57\u3002\r\n\u5DE6\u908A\u662F\u5B0C\u5A9A\u7684\u5A18\u5A18\uFF0C\u53F3\u908A\u662F\u903C\u5A5A\u7684\u80A1\u6771\uFF0C\u8166\u5B50\u88E1\u9084\u6709\u52C7\u8005\u7CFB\u7D71\u50AC\u4FC3\u6211\u53BB\u6253\u9B54\u738B\u3002\u6211\u7C21\u76F4\u60F3\u5927\u558A\uFF1A\u300C\u80FD\u4E0D\u80FD\u8B93\u6211\u5148\u628A\u65E9\u9910\u5403\u5B8C\uFF01\u300D\r\n\u7136\u800C\uFF0C\u8EAB\u70BA\u4E00\u500B\u5408\u683C\u7684\u9738\u9053\u7E3D\u88C1\uFF0C\u6211\u5FC5\u9808\u7DAD\u6301\u9AD8\u51B7\u3002\u65BC\u662F\u6211\u62AC\u8D77\u982D\uFF0C\u7528\u90A3\u62DB\u724C\u7684\u7E3D\u88C1\u8A9E\u6C23\u56DE\u7B54\uFF1A\u300C\u4E0D\u7BA1\u662F\u8AB0\uFF0C\u53EA\u8981\u5728\u6211\u8EAB\u908A\u2026\u2026\u5C31\u5FC5\u9808\u611B\u6211\uFF01\u300D\r\n\u5168\u5834\u518D\u5EA6\u7206\u70B8\u3002\u5B2A\u5983\u5011\u6342\u8457\u81C9\u5927\u558A\uFF1A\u300C\u5C11\u723A\u597D\u9738\u6C23\uFF01\u300D\r\n\u80A1\u6771\u5011\u7AD9\u8D77\u4F86\u9F13\u638C\uFF1A\u300C\u8463\u4E8B\u9577\u842C\u6B72\uFF01\u300D\r\n\u9023\u5FA1\u82B1\u5712\u88E1\u7684\u85CD\u8272\u5927\u8611\u83C7\u90FD\u300C\u5657\u300D\u5730\u5192\u4E86\u4E00\u53E3\u767D\u7159\uFF0C\u50CF\u662F\u5728\u6176\u795D\u3002\r\n\u6211\u5FC3\u60F3\uFF1A\u9019\u4E0B\u7CDF\u4E86\uFF0C\u5834\u5B50\u88AB\u6211\u73A9\u5927\u4E86\u3002\r\n\u4F46\u4E0D\u7BA1\u600E\u6A23\uFF0C\u9019\u5C31\u662F\u6211\uFF0C\u4E09\u91CD\u8EAB\u4EFD\u7684\u958B\u59CB\u3002\r\n\u52C7\u8005\u3002\u5BAE\u5EF7\u5C0F\u5B98\u4E4B\u5B50\u3002\u9738\u9053\u7E3D\u88C1\u3002\r\n\u800C\u4E14\u9084\u662F\u65E9\u9910\u6C92\u5403\u5B8C\u7684\u90A3\u7A2E\u3002\r\n\u5FA1\u82B1\u5712\u7684\u5BB4\u6703\u7D50\u675F\u4E4B\u5F8C\uFF0C\u6211\u539F\u672C\u4EE5\u70BA\u53EF\u4EE5\u56DE\u623F\u9593\u7E7C\u7E8C\u88DC\u7720\uFF0C\u9806\u4FBF\u628A\u90A3\u9846\u5269\u4E0B\u7684\u6C34\u716E\u86CB\u5403\u6389\u3002\u53EF\u60DC\u5929\u610F\u5F04\u4EBA\uFF0C\u6211\u525B\u5750\u4E0B\u4F86\uFF0C\u8336\u9084\u6C92\u559D\u4E00\u53E3\uFF0C\u5BAE\u88E1\u7684\u5167\u4F8D\u4FBF\u53C8\u6025\u6025\u5FD9\u5FD9\u8DD1\u9032\u4F86\uFF0C\u5C16\u8072\u5927\u53EB\uFF1A\r\n\u300C\u5C11\u723A\uFF01\u4E0D\u597D\u5566\uFF01\u5F8C\u5BAE\u5E7E\u4F4D\u5A18\u5A18\u70BA\u4E86\u60A8\u65E9\u9910\u7684\u8336\u8449\u86CB\uFF0C\u5DF2\u7D93\u722D\u5435\u8D77\u4F86\u5566\uFF01\u300D\r\n\u6211\u4E00\u6123\uFF0C\u8336\u676F\u5DEE\u9EDE\u6389\u5728\u5730\u4E0A\u3002\r\n\u300C\u4EC0\u9EBC\uFF1F\u8336\u8449\u86CB\uFF1F\u300D\r\n\u5167\u4F8D\u6EFF\u982D\u5927\u6C57\uFF0C\u4E0D\u505C\u9EDE\u982D\uFF1A\u300C\u662F\u554A\uFF0C\u4ECA\u65E5\u5FA1\u81B3\u623F\u53EA\u716E\u4E86\u4E03\u9846\u8336\u8449\u86CB\uFF0C\u4F46\u5A18\u5A18\u5011\u537B\u6709\u516B\u4F4D\u2026\u2026\u7D50\u679C\u5C31\u70BA\u4E86\u6700\u5F8C\u90A3\u4E00\u9846\u5435\u8D77\u4F86\u4E86\u3002\u6709\u4EBA\u8AAA\u8981\u8B93\u7D66\u60A8\uFF0C\u6709\u4EBA\u8AAA\u8981\u81EA\u5DF1\u5403\uFF0C\u9084\u6709\u4EBA\u8AAA\u4E7E\u8106\u4E1F\u9032\u6C60\u5858\uFF0C\u7701\u5F97\u722D\u4F86\u722D\u53BB\uFF01\u300D\r\n\u6211\u8166\u6D77\u77AC\u9593\u6D6E\u73FE\u51FA\u756B\u9762\uFF1A\u516B\u4F4D\u5A18\u5A18\u570D\u8457\u4E00\u7897\u8336\u8449\u86CB\uFF0C\u773C\u795E\u6BD4\u6BD2\u86C7\u9084\u72E0\uFF0C\u6BD4\u72FC\u7FA4\u9084\u5147\u3002\r\n\u6211\u5FCD\u4E0D\u4F4F\u6276\u984D\uFF0C\u5FC3\u60F3\uFF1A\u771F\u662F\u5EB8\u4FD7\u5230\u6975\u9EDE\u3002\u8336\u8449\u86CB\u8036\uFF0C\u4E0D\u662F\u9F8D\u809D\u9CF3\u9AD3\uFF0C\u4E0D\u662F\u4ED9\u4E39\u5999\u85E5\uFF0C\u5C31\u53EA\u662F\u4E00\u9846\u86CB\u3002\u53EF\u504F\u504F\uFF0C\u9019\u5C31\u662F\u5BAE\u9B25\u7684\u958B\u59CB\u3002\r\n________________________________________\r\n\u6211\u8D95\u5230\u5FA1\u81B3\u623F\u7684\u6642\u5019\uFF0C\u679C\u7136\u770B\u5230\u4E00\u5834\u9A5A\u5FC3\u52D5\u9B44\u7684\u5834\u9762\u3002\r\n\u5FA1\u81B3\u623F\u4E2D\u592E\u7684\u684C\u4E0A\uFF0C\u64FA\u8457\u90A3\u9846\u6700\u5F8C\u7684\u8336\u8449\u86CB\u3002\u5B83\u975C\u975C\u5730\u8EBA\u5728\u74F7\u7897\u88E1\uFF0C\u86CB\u6BBC\u88C2\u51FA\u5E7E\u9053\u7D0B\u8DEF\uFF0C\u6EF7\u6C41\u7684\u9999\u5473\u7030\u6F2B\u6574\u500B\u623F\u9593\u3002\u53EF\u662F\u5B83\u7684\u5B58\u5728\uFF0C\u5C31\u50CF\u4E00\u679A\u5B9A\u6642\u70B8\u5F48\u3002\r\n\u5DE6\u908A\u662F\u6DD1\u5983\u5A18\u5A18\uFF0C\u5979\u773C\u795E\u5982\u6BD2\u86C7\uFF0C\u51B7\u51B7\u5730\u76EF\u8457\u90A3\u9846\u86CB\u3002\u53F3\u908A\u662F\u9E97\u5B2A\uFF0C\u5979\u773C\u795E\u50CF\u5C0F\u767D\u5154\uFF0C\u537B\u9583\u8457\u72E1\u8A50\u7684\u5149\u8292\u3002\u9084\u6709\u5176\u4ED6\u5A18\u5A18\u5011\uFF0C\u6709\u7684\u5B0C\u5598\u9023\u9023\uFF0C\u6709\u7684\u78E8\u7259\u970D\u970D\uFF0C\u7E3D\u4E4B\u516B\u7A2E\u773C\u795E\u5168\u90FD\u96C6\u4E2D\u5728\u540C\u4E00\u9846\u8336\u8449\u86CB\u4E0A\u3002\r\n\u6211\u4E00\u8E0F\u9032\u53BB\uFF0C\u5834\u9762\u7ACB\u523B\u5B89\u975C\u4E0B\u4F86\u3002\r\n\u300C\u5C11\u723A\uFF01\u300D\u5979\u5011\u7570\u53E3\u540C\u8072\u558A\u9053\u3002\r\n\u6211\u4E00\u9663\u982D\u76AE\u767C\u9EBB\uFF0C\u56E0\u70BA\u5979\u5011\u558A\u7684\u8072\u97F3\u88E1\u5145\u6EFF\u4E86\u4E0D\u540C\u7684\u60C5\u7DD2\uFF1A\u6709\u671F\u5F85\u3001\u6709\u5AC9\u5992\u3001\u6709\u611B\u6155\u3001\u6709\u6068\u610F\uFF0C\u9084\u647B\u96DC\u8457\u4E00\u9EDE\u9EDE\u300C\u60F3\u628A\u8336\u8449\u86CB\u7838\u6211\u81C9\u4E0A\u300D\u7684\u885D\u52D5\u3002\r\n\u300C\u5C11\u723A\uFF0C\u9019\u9846\u8336\u8449\u86CB\u2026\u2026\u61C9\u8A72\u6B78\u8AB0\u5462\uFF1F\u300D\u6DD1\u5983\u5A18\u5A18\u7387\u5148\u958B\u53E3\uFF0C\u8A9E\u6C23\u6EAB\u67D4\u537B\u85CF\u8457\u5200\u5B50\u3002\r\n\u300C\u5C0D\u554A\uFF0C\u5C11\u723A\uFF0C\u60A8\u6700\u75BC\u7684\u662F\u8AB0\uFF0C\u5C31\u628A\u9019\u9846\u86CB\u7D66\u8AB0\u5427\uFF01\u300D\u9E97\u5B2A\u7B11\u5F97\u751C\u7F8E\uFF0C\u53EF\u624B\u6307\u537B\u7DCA\u7DCA\u6473\u8457\u684C\u908A\uFF0C\u6307\u7BC0\u767C\u767D\u3002\r\n\u300C\u4E0D\u884C\uFF01\u9019\u86CB\u61C9\u8A72\u8CDE\u7D66\u5974\u5A62\uFF01\u300D\u53E6\u4E00\u4F4D\u5C0F\u4E3B\u7AD9\u51FA\u4F86\uFF0C\u773C\u795E\u5805\u6C7A\uFF0C\u300C\u5974\u5A62\u96D6\u7136\u5730\u4F4D\u5351\u5FAE\uFF0C\u53EF\u5974\u5A62\u6700\u61C2\u5C11\u723A\u5FC3\u610F\uFF01\u300D\r\n\u623F\u9593\u88E1\u7684\u7A7A\u6C23\u77AC\u9593\u51DD\u56FA\u3002\u5979\u5011\u7684\u8996\u7DDA\u4EA4\u932F\uFF0C\u50CF\u7121\u6578\u5200\u528D\u5728\u7A7A\u4E2D\u78B0\u649E\u3002\r\n\u6211\u5FC3\u60F3\uFF1A\u9019\u4E0D\u5C31\u662F\u50B3\u8AAA\u4E2D\u7684\u5BAE\u9B25\u55CE\uFF1F\u53EA\u662F\u5C0D\u8C61\u4E0D\u662F\u9CF3\u51A0\u971E\u5E14\uFF0C\u4E0D\u662F\u7687\u540E\u5BF6\u5EA7\uFF0C\u800C\u662F\u4E00\u9846\u8336\u8449\u86CB\u3002\r\n________________________________________\r\n\u300C\u5B89\u975C\uFF01\u300D\u6211\u5927\u558A\u4E00\u8072\uFF0C\u5B78\u8457\u7E3D\u88C1\u90A3\u5957\u6C23\u5834\uFF0C\u628A\u624B\u91CD\u91CD\u4E00\u62CD\u684C\u5B50\u3002\r\n\u684C\u5B50\u4E00\u9707\uFF0C\u8336\u8449\u86CB\u6EFE\u4E86\u534A\u5708\uFF0C\u6240\u6709\u4EBA\u7ACB\u523B\u5C4F\u4F4F\u547C\u5438\u3002\r\n\u6211\u6162\u6162\u958B\u53E3\uFF0C\u8072\u97F3\u4F4E\u6C89\uFF1A\u300C\u4F60\u5011\u77E5\u9053\u55CE\uFF1F\u5728\u6211\u773C\u88E1\uFF0C\u4F60\u5011\u6BCF\u4E00\u500B\u4EBA\u2026\u2026\u90FD\u6BD4\u8336\u8449\u86CB\u91CD\u8981\u3002\u300D\r\n\u516B\u4F4D\u5A18\u5A18\u540C\u6642\u5012\u5438\u4E00\u53E3\u6C23\u3002\r\n\u6211\u7E7C\u7E8C\u8AAA\uFF1A\u300C\u8336\u8449\u86CB\u96D6\u597D\uFF0C\u4F46\u4EBA\u5FC3\u66F4\u53EF\u8CB4\u3002\u4ECA\u5929\u9019\u86CB\uFF0C\u6211\u4E0D\u6703\u7D66\u4EFB\u4F55\u4E00\u500B\u4EBA\u3002\u56E0\u70BA\u5728\u6211\u5FC3\u88E1\uFF0C\u4F60\u5011\u90FD\u662F\u7121\u6CD5\u53D6\u4EE3\u7684\u5B58\u5728\u3002\u300D\r\n\u8A71\u97F3\u525B\u843D\uFF0C\u5A18\u5A18\u5011\u7684\u81C9\u8272\u5404\u7570\u3002\u6709\u4EBA\u611F\u52D5\u843D\u6DDA\uFF0C\u6709\u4EBA\u54AC\u7259\u5207\u9F52\uFF0C\u6709\u4EBA\u5F37\u984F\u6B61\u7B11\u3002\r\n\u6DD1\u5983\u5A18\u5A18\u4F4E\u8072\u7B11\u4E86\uFF1A\u300C\u5C11\u723A\uFF0C\u60A8\u8AAA\u5F97\u771F\u597D\u807D\uFF0C\u53EF\u662F\u2026\u2026\u65E2\u7136\u8336\u8449\u86CB\u4E0D\u5C6C\u65BC\u6211\u5011\uFF0C\u90A3\u5B83\u5C6C\u65BC\u8AB0\u5462\uFF1F\u300D\r\n\u6211\u6B63\u60F3\u56DE\u7B54\uFF0C\u8166\u6D77\u88E1\u7684\u52A9\u7406\u5C0F\u738B\u7A81\u7136\u63D2\u8A71\uFF1A\u300C\u8463\u4E8B\u9577\uFF0C\u9019\u86CB\u61C9\u8A72\u62FF\u53BB\u6295\u8CC7\uFF01\u5982\u679C\u628A\u5B83\u7576\u6210\u9650\u91CF\u7248\u7522\u54C1\u63A8\u51FA\u5E02\u5834\uFF0C\u7ACB\u523B\u80FD\u62AC\u9AD8\u80A1\u50F9\uFF01\u4F60\u600E\u9EBC\u9019\u9EBC\u7B28\uFF0C\u6211\u9019\u88E1\u9001\u7D66\u4F60\u4E00\u672C\u6709\u540D\u7684\u7D93\u6FDF\u5B78\u66F8\u7C4D\u570B\u5BCC\u8AD6\uFF0C\u4F60\u7D66\u6211\u597D\u597D\u8B80\uFF01\u300D\u96A8\u5F8C\u5C0F\u738B\u628A\u539A\u539A\u7684\u570B\u5BCC\u8AD6\u4E1F\u5230\u6211\u7684\u982D\u4E0A\u3002\r\n\u6211\u5DEE\u9EDE\u6C92\u660F\u904E\u53BB\u3002\r\n\u800C\u5C31\u5728\u9019\u500B\u77AC\u9593\uFF0C\u9E97\u5B2A\u731B\u5730\u4F38\u624B\uFF0C\u60F3\u8981\u6436\u8D70\u90A3\u9846\u8336\u8449\u86CB\uFF01\r\n\u300C\u554A\uFF01\u300D\u5176\u4ED6\u4EBA\u540C\u6642\u9A5A\u53EB\uFF0C\u7ACB\u523B\u64B2\u4E0A\u53BB\u6514\u5979\u3002\u5E7E\u4F4D\u5A18\u5A18\u6495\u626F\u5728\u4E00\u8D77\uFF0C\u8863\u8896\u98DB\u821E\uFF0C\u9AEE\u7C2A\u6389\u4E86\u4E00\u5730\uFF0C\u5834\u9762\u6DF7\u4E82\u5F97\u50CF\u5E02\u96C6\u5927\u7529\u8CE3\u3002\r\n\u6211\u6123\u5728\u539F\u5730\uFF0C\u53EA\u80FD\u773C\u775C\u775C\u770B\u8457\u516B\u4F4D\u5A18\u5A18\u70BA\u4E86\u90A3\u9846\u86CB\u626D\u6253\u6210\u4E00\u5718\u3002\u6709\u4EBA\u626F\u982D\u9AEE\uFF0C\u6709\u4EBA\u6390\u624B\u81C2\uFF0C\u9084\u6709\u4EBA\u4E7E\u8106\u4E00\u5C41\u80A1\u5750\u5230\u684C\u5B50\u4E0A\uFF0C\u5DEE\u9EDE\u628A\u8336\u8449\u86CB\u58D3\u788E\u3002\r\n\u6211\u5927\u558A\uFF1A\u300C\u4F4F\u624B\uFF01\u90FD\u7D66\u6211\u4F4F\u624B\uFF01\u300D\r\n\u53EF\u6C92\u4EBA\u807D\u3002\u5979\u5011\u7684\u5C16\u53EB\u8072\u6B64\u8D77\u5F7C\u4F0F\uFF1A\r\n\u300C\u9019\u662F\u6211\u7684\uFF01\u300D\r\n\u300C\u4E0D\uFF0C\u662F\u6211\u7684\uFF01\u300D\r\n\u300C\u4F60\u6191\u4EC0\u9EBC\u6436\uFF01\u300D\r\n\u300C\u5C11\u723A\u660E\u660E\u6700\u611B\u6211\uFF01\u300D\r\n\u6700\u5F8C\uFF0C\u8336\u8449\u86CB\u5728\u6DF7\u4E82\u4E2D\u88AB\u649E\u98DB\uFF0C\u556A\u55D2\u4E00\u8072\u6389\u5230\u5730\u4E0A\uFF0C\u6BBC\u88C2\u958B\u4F86\uFF0C\u6EF7\u6C41\u6EF2\u4E86\u4E00\u5730\u3002\r\n\u5168\u5834\u77AC\u9593\u5B89\u975C\u3002\r\n\u5A18\u5A18\u5011\u5446\u5446\u5730\u770B\u8457\u5730\u4E0A\u7684\u86CB\uFF0C\u773C\u795E\u88E1\u5145\u6EFF\u7D55\u671B\u3002\u5C31\u50CF\u5929\u584C\u4E0B\u4F86\u4E00\u6A23\u3002\r\n\u6211\u89BA\u5F97\u982D\u66F4\u75DB\u4E86\u3002\r\n\u300C\u5509\u2026\u2026\u300D\u6211\u5606\u4E86\u53E3\u6C23\uFF0C\u8D70\u4E0A\u524D\uFF0C\u8E72\u4E0B\u8EAB\uFF0C\u628A\u788E\u88C2\u7684\u8336\u8449\u86CB\u64BF\u8D77\u4F86\u3002\r\n\u300C\u65E2\u7136\u4F60\u5011\u722D\u4E0D\u51FA\u52DD\u8CA0\uFF0C\u90A3\u9EBC\u9019\u9846\u86CB\uFF0C\u5C31\u7531\u6211\u4F86\u627F\u64D4\u3002\u300D\r\n\u6211\u628A\u86CB\u9001\u9032\u5634\u88E1\uFF0C\u5927\u53E3\u54AC\u4E0B\u53BB\u3002\u96D6\u7136\u6709\u9EDE\u6C99\u6C99\u7684\u6BBC\uFF0C\u4F46\u5473\u9053\u610F\u5916\u9084\u4E0D\u932F\u3002\r\n\u5A18\u5A18\u5011\u540C\u6642\u9A5A\u547C\uFF1A\u300C\u5C11\u723A\u2026\u2026\uFF01\u300D\r\n\u6211\u541E\u4E0B\u53BB\uFF0C\u62AC\u982D\uFF0C\u51B7\u51B7\u4E00\u7B11\uFF1A\u300C\u8A18\u4F4F\uFF0C\u9019\u5F8C\u5BAE\u88E1\u7684\u6240\u6709\u8336\u8449\u86CB\uFF0C\u53EA\u80FD\u5C6C\u65BC\u6211\u3002\u300D\r\n\u9019\u53E5\u8A71\u4E00\u51FA\uFF0C\u516B\u4F4D\u5A18\u5A18\u5168\u90E8\u8DEA\u4E0B\uFF0C\u773C\u795E\u6216\u8FF7\u6200\u3001\u6216\u6028\u6068\uFF0C\u4F46\u7121\u4E00\u4F8B\u5916\uFF0C\u5168\u90FD\u7262\u7262\u76EF\u8457\u6211\u3002\r\n\u8336\u8449\u86CB\u4E4B\u6230\uFF0C\u5C31\u9019\u6A23\u7D50\u675F\u4E86\u3002\r\n\u4F46\u6211\u96B1\u96B1\u611F\u89BA\u5230\uFF0C\u9019\u53EA\u662F\u958B\u59CB\u3002\u56E0\u70BA\u5728\u9019\u5BAE\u5EF7\u88E1\uFF0C\u4E0B\u4E00\u6B21\u722D\u596A\u7684\uFF0C\u53EF\u80FD\u4E0D\u662F\u86CB\uFF0C\u800C\u662F\u6211\u672C\u4EBA\u3002\r\n\u7FCC\u65E5\uFF0C\u57CE\u5821\u7684\u82B1\u5712\u88E1\u76DB\u958B\u8457\u5404\u7A2E\u8A87\u5F35\u5230\u4E0D\u5408\u6642\u5B9C\u7684\u82B1\u5349\uFF1A\u7C89\u7D05\u8272\u7684\u73AB\u7470\u6BD4\u81C9\u76C6\u9084\u5927\uFF0C\u7D2B\u8272\u7684\u9B31\u91D1\u9999\u6703\u96A8\u98A8\u81EA\u52D5\u6416\u64FA\uFF0C\u9084\u6703\u6563\u767C\u51FA\u300C\u53EE\u9234\u53EE\u9234\u300D\u7684\u9234\u8072\u3002\u9019\u4E9B\u82B1\u4E0D\u50C5\u6C92\u6709\u5687\u5230\u8F49\u751F\u6210\u516C\u4E3B\u7684\u6211\uFF0C\u53CD\u800C\u8B93\u6211\u6709\u7A2E\u8D70\u9032\u5EC9\u50F9\u5C11\u5973\u6F2B\u756B\u5C01\u9762\u7684\u932F\u89BA\u3002\r\n\u2003\u2003\u300C\u5404\u4F4D\u5343\u91D1\u5C0F\u59D0\uFF0C\u4ECA\u65E5\u8336\u6703\u7531\u672C\u5C11\u723A\u89AA\u81EA\u4E3B\u6301\u3002\u300D\u9738\u9053\u7E3D\u88C1\u827E\u745E\u514B\xB7\u591C\u672A\u7720\u2014\u2014\u662F\u7684\uFF0C\u4ED6\u540D\u5B57\u771F\u7684\u9019\u9EBC\u4E2D\u4E8C\u2014\u2014\u4E00\u8EAB\u767D\u8272\u71D5\u5C3E\u670D\uFF0C\u624B\u62FF\u91D1\u908A\u6C34\u6676\u676F\uFF0C\u6C23\u52E2\u6EFF\u6EFF\u5730\u7AD9\u5728\u82B1\u5712\u6B63\u4E2D\u592E\u3002\r\n\u2003\u2003\u4E00\u7FA4\u7A7F\u8457\u8A87\u5F35\u84EC\u88D9\u7684\u8CB4\u65CF\u5C0F\u59D0\u5011\u7ACB\u523B\u767C\u51FA\u300C\u54C7\u2014\u2014\u300D\u7684\u9A5A\u547C\u8072\uFF0C\u50CF\u662F\u770B\u898B\u4EC0\u9EBC\u5076\u50CF\u6F14\u5531\u6703\u7684\u958B\u5834\u4E00\u6A23\u3002\r\n\u2003\u2003\u300C\u591C\u672A\u7720\u5C11\u723A\u592A\u5E25\u4E86\uFF01\u300D\r\n\u2003\u2003\u300C\u554A\u554A\u554A\uFF01\u5982\u679C\u80FD\u548C\u4ED6\u4E00\u8D77\u559D\u8336\uFF0C\u6211\u6B7B\u800C\u7121\u61BE\uFF01\u300D\r\n\u2003\u2003\u300C\u807D\u8AAA\u4ED6\u9084\u662F\u4E09\u570B\u4E03\u5927\u8CA1\u95A5\u4E4B\u4E00\u7684\u7E7C\u627F\u4EBA\uFF01\u300D\r\n\u2003\u2003\u6211\u5728\u89D2\u843D\u9ED8\u9ED8\u559D\u8457\u4E0D\u77E5\u9053\u52A0\u4E86\u5E7E\u52FA\u7CD6\u7684\u7D05\u8336\uFF0C\u751C\u5F97\u7259\u9F52\u90FD\u5FEB\u6389\u5149\u3002\u5FC3\u88E1\u5FCD\u4E0D\u4F4F\u5410\u69FD\uFF1A**\u9019\u7A2E\u5287\u60C5\u4E0D\u5C31\u662F\u300C\u7E3D\u88C1\u6587\u300D\u7684\u5FC5\u5099\u5957\u8DEF\u55CE\uFF1F**\u63A5\u4E0B\u4F86\u5927\u6982\u5C31\u6703\u51FA\u73FE\u4EC0\u9EBC\u8336\u6C34\u6F51\u81C9\u3001\u8E29\u88D9\u5B50\u3001\u6436\u7537\u4EBA\u7684\u6232\u78BC\u5427\u3002\r\n\u2003\u2003\u679C\u4E0D\u5176\u7136\uFF0C\u4E0B\u4E00\u79D2\uFF0C\u5750\u5728\u6211\u65C1\u908A\u7684\u7DA0\u8336\u5927\u5C0F\u59D0\u8389\u8389\u5B89\u7A81\u7136\u4F38\u51FA\u624B\uFF0C\u4E0D\u5C0F\u5FC3\u628A\u8336\u6C34\u6F51\u5230\u53E6\u4E00\u4F4D\u7D05\u9AEE\u5C0F\u59D0\u7684\u81C9\u4E0A\u3002\r\n\u2003\u2003\u300C\u554A\u5440\u5440\uFF01\u771F\u662F\u4E0D\u597D\u610F\u601D\u5462\uFF0C\u6211\u624B\u4E00\u6296\u3002\u300D\u8389\u8389\u5B89\u6342\u5634\u5077\u7B11\uFF0C\u773C\u795E\u537B\u5F97\u610F\u6D0B\u6D0B\u3002\r\n\u2003\u2003\u7D05\u9AEE\u5C0F\u59D0\u6C23\u5F97\u62CD\u684C\uFF1A\u300C\u4F60\u9019\u662F\u6545\u610F\u7684\u5427\uFF01\u300D\r\n\u2003\u2003\u73FE\u5834\u7A7A\u6C23\u77AC\u9593\u51DD\u56FA\u3002\u6240\u6709\u4EBA\u76EE\u5149\u5728\u5169\u4EBA\u4E4B\u9593\u4F86\u56DE\u79FB\u52D5\uFF0C\u50CF\u662F\u7B49\u5F85\u5373\u5C07\u7206\u767C\u7684\u6495\u88D9\u5927\u6230\u3002\r\n\u2003\u2003\u9738\u7E3D\u827E\u745E\u514B\u6311\u4E86\u6311\u7709\uFF0C\u5634\u89D2\u52FE\u8D77\u4E00\u62B9\u4E0D\u8010\u7169\u537B\u5E25\u6C23\u7684\u5F27\u5EA6\uFF0C\u4F4E\u6C89\u958B\u53E3\uFF1A\u300C\u5920\u4E86\uFF0C\u5225\u5728\u6211\u7684\u8336\u6703\u4E0A\u4E1F\u4EBA\u73FE\u773C\u3002\u300D\r\n\u2003\u2003\u8A9E\u6C23\u9738\u9053\u5230\u4E0D\u5BB9\u53CD\u99C1\u3002\u6240\u6709\u5343\u91D1\u5C0F\u59D0\u7ACB\u523B\u4E56\u4E56\u9589\u5634\uFF0C\u4F4E\u982D\u5047\u88DD\u559D\u8336\u3002\r\n\u2003\u2003\u300C\u2026\u2026\u597D\u719F\u6089\u7684\u5473\u9053\u3002\u300D\u6211\u5600\u5495\u8457\u3002\u9019\u53F0\u8A5E\u6211\u6628\u5929\u624D\u5728\u67D0\u672C\u9738\u7E3D\u5C0F\u8AAA\u88E1\u770B\u904E\uFF0C\u9023\u6A19\u9EDE\u7B26\u865F\u90FD\u4E00\u6A23\u3002\r\n\u2003\u2003\u800C\u9019\u6642\uFF0C\u827E\u745E\u514B\u7684\u8996\u7DDA\u843D\u5230\u6211\u8EAB\u4E0A\uFF0C\u773C\u795E\u50CF\u63A2\u7167\u71C8\u4E00\u6A23\u76F4\u5C04\u904E\u4F86\uFF0C\u5E36\u8457\u90A3\u7A2E\u300C\u4F60\u5C31\u662F\u547D\u4E2D\u6CE8\u5B9A\u7684\u5973\u4EBA\u300D\u7684\u65E2\u8996\u611F\u3002\r\n\u2003\u2003\u300C\u4F60\u2014\u2014\u300D\u4ED6\u9081\u6B65\u8D70\u4F86\uFF0C\u4FEE\u9577\u7684\u5F71\u5B50\u7C60\u7F69\u5728\u6211\u8EAB\u4E0A\uFF0C\u300C\u70BA\u4EC0\u9EBC\u8207\u773E\u4E0D\u540C\uFF1F\u300D\r\n\u2003\u2003\u6211\u5DEE\u9EDE\u628A\u7D05\u8336\u55C6\u51FA\u4F86\uFF1A\u5144\u5F1F\uFF0C\u6211\u53EA\u662F\u6C92\u53C3\u8207\u8336\u6C34\u6F51\u81C9\u800C\u5DF2\u554A\uFF01\u9019\u4E5F\u7B97\u8207\u773E\u4E0D\u540C\u55CE\uFF1F\r\n\u2014\u2014\r\n\u674E\u96F2\u7A7F\u8457\u90A3\u4EF6\u83EF\u9E97\u5230\u523A\u773C\u7684\u9577\u888D\uFF0C\u88AB\u5169\u540D\u5BAE\u5973\u7C07\u64C1\u8457\u8D70\u9032\u4E86\u7687\u5BAE\u7684\u5927\u6BBF\u3002\u5927\u6BBF\u91D1\u78A7\u8F1D\u714C\uFF0C\u5C4B\u6A11\u4E0A\u639B\u8457\u6C34\u6676\u71C8\uFF0C\u53CD\u5C04\u51FA\u523A\u76EE\u7684\u5149\u8292\uFF0C\u5730\u4E0A\u92EA\u6EFF\u4E86\u7D05\u6BEF\uFF0C\u9577\u684C\u4E0A\u64FA\u6EFF\u4E86\u5C71\u73CD\u6D77\u5473\u3002\r\n\u4ED6\u5FCD\u4E0D\u4F4F\u5728\u5FC3\u88E1\u5410\u69FD\uFF1A\u300C\u9019\u5BB4\u6703\u5834\u666F\u6D3B\u812B\u812B\u5C31\u662F\u8C6A\u9580\u7E3D\u88C1\u5A5A\u79AE\u73FE\u5834\uFF0C\u53EA\u5DEE\u500B\u4E3B\u6301\u4EBA\u558A\u2018\u65B0\u90CE\u5B98\u767B\u5834\u2019\u4E86\u3002\u300D\r\n\u5C31\u5728\u4ED6\u80E1\u601D\u4E82\u60F3\u4E4B\u969B\uFF0C\u4E00\u500B\u8072\u97F3\u5F9E\u9AD8\u53F0\u4E0A\u97FF\u8D77\u3002\r\n\u300C\u674E\u96F2\uFF0C\u807D\u805E\u4F60\u81EA\u7A31\u4F86\u81EA\u7570\u4E16\uFF0C\u53C8\u5F97\u592A\u5B50\u9752\u775E\uFF0C\u7279\u8CDC\u4F60\u4E0A\u5EA7\u3002\u300D\r\n\u9019\u8072\u97F3\u4F86\u81EA\u65BC\u7687\u5E1D\uFF0C\u6EFF\u81C9\u9B0D\u5B50\uFF0C\u773C\u795E\u6DF1\u4E0D\u53EF\u6E2C\u3002\u674E\u96F2\u5FC3\u982D\u4E00\u7DCA\uFF0C\u7ACB\u523B\u64FA\u51FA\u4E00\u672C\u6B63\u7D93\u7684\u7B11\u5BB9\uFF1A\u300C\u591A\u8B1D\u965B\u4E0B\u539A\u611B\uFF0C\u5C0F\u7684\u53D7\u5BF5\u82E5\u9A5A\u3002\u300D\r\n\u679C\u4E0D\u5176\u7136\uFF0C\u4E00\u540D\u8EAB\u8457\u7D2B\u888D\u7684\u738B\u723A\u62CD\u6848\u800C\u8D77\uFF0C\u6307\u8457\u674E\u96F2\u6012\u559D\uFF1A\u300C\u4E00\u4ECB\u4F86\u8DEF\u4E0D\u660E\u7684\u8CE4\u6C11\uFF0C\u6191\u4EC0\u9EBC\u5750\u5728\u6211\u7B49\u4E4B\u4E0A\uFF1F\uFF01\u300D\r\n\u773E\u4EBA\u5012\u62BD\u4E00\u53E3\u6C23\uFF0C\u73FE\u5834\u6C23\u6C1B\u77AC\u9593\u51DD\u56FA\u3002\r\n\u592A\u5B50\u51B7\u51B7\u4E00\u7B11\uFF0C\u624B\u638C\u4E00\u63EE\uFF1A\u300C\u4F86\u4EBA\uFF0C\u628A\u9019\u4F4D\u738B\u53D4\u7684\u9152\u518D\u659F\u6EFF\uFF0C\u8B93\u4ED6\u559D\u500B\u75DB\u5FEB\u3002\u300D\r\n\u9019\u8A71\u770B\u4F3C\u548C\u6C23\uFF0C\u537B\u6697\u85CF\u6BBA\u6A5F\u3002\u738B\u723A\u81C9\u8272\u9435\u9752\uFF0C\u537B\u53C8\u4E0D\u5F97\u4E0D\u52C9\u5F37\u8209\u676F\u3002\r\n\u674E\u96F2\u5728\u4E00\u65C1\u770B\u5F97\u4E00\u6123\u4E00\u6123\u7684\u3002\r\n\u5C31\u5728\u4ED6\u6B63\u6253\u7B97\u5077\u5403\u684C\u4E0A\u7684\u9F8D\u8766\u6642\uFF0C\u4E00\u540D\u8EAB\u7A7F\u6DFA\u85CD\u8272\u5BAE\u88D9\u7684\u5973\u5B50\u6B3E\u6B3E\u8D70\u4F86\u3002\u5979\u6C23\u8CEA\u6E05\u51B7\uFF0C\u773C\u795E\u537B\u5E36\u8457\u5E7E\u5206\u597D\u5947\uFF0C\u76F4\u76F4\u76EF\u8457\u674E\u96F2\u3002\r\n\u300C\u4F60\uFF0C\u5C31\u662F\u90A3\u500B\u4F86\u81EA\u7570\u4E16\u4E4B\u4EBA\uFF1F\u300D\u5979\u8072\u97F3\u6E05\u8106\uFF0C\u537B\u53C8\u5E36\u8457\u58D3\u8FEB\u611F\u3002\r\n\u674E\u96F2\u5DEE\u9EDE\u88AB\u8766\u6BBC\u5361\u4F4F\u5589\u56A8\uFF0C\u5C37\u5C2C\u5730\u7B11\u4E86\u7B11\uFF1A\u300C\u554A\uFF0C\u5C0D\u5C0D\uFF0C\u6211\u5C31\u662F\u3002\u5443\uFF0C\u6562\u554F\u59D1\u5A18\u5C0A\u59D3\u5927\u540D\uFF1F\u300D\r\n\u300C\u672C\u5BAE\u4E43\u662F\u56DB\u516C\u4E3B\u3002\u300D\u5973\u5B50\u62AC\u8D77\u4E0B\u5DF4\uFF0C\u6EFF\u662F\u50B2\u6C23\u3002\r\n\u63A5\u8457\uFF0C\u5979\u51B7\u51B7\u4E1F\u4E0B\u4E00\u53E5\uFF1A\u300C\u5E0C\u671B\u4F60\u4E0D\u8981\u4EE5\u70BA\u5F97\u4E86\u592A\u5B50\u7684\u5BF5\uFF0C\u5C31\u80FD\u6A6B\u884C\u7121\u5FCC\u3002\u300D\r\n\u5927\u6BBF\u77AC\u9593\u53C8\u662F\u4E00\u9663\u4F4E\u8A9E\uFF0C\u7FA4\u81E3\u7ACA\u7ACA\u79C1\u8A9E\uFF0C\u773C\u795E\u5728\u674E\u96F2\u548C\u516C\u4E3B\u4E4B\u9593\u4F86\u56DE\u6E38\u79FB\u3002\r\n\u2014\u2014\u674E\u96F2\u5FC3\u88E1\u72C2\u53EB
        \r\n\u592A\u5B50\u537B\u53EA\u662F\u6DE1\u6DE1\u4E00\u7B11\uFF0C\u4F38\u624B\u6309\u4F4F\u674E\u96F2\u7684\u80A9\u8180\uFF0C\u8A9E\u6C23\u9738\u9053\u5230\u6975\u81F4\uFF1A\u300C\u5728\u5B64\u7684\u5730\u76E4\uFF0C\u8AB0\u6562\u52D5\u4ED6\uFF1F\u300D\r\n\u5168\u5834\u9D09\u96C0\u7121\u8072\u3002\r\n\u674E\u96F2\u5FCD\u4E0D\u4F4F\u6296\u4E86\u6296\u3002\u5FC3\u88E1\u660E\u767D\u2014\u2014\u9019\u5834\u5BB4\u6703\uFF0C\u4E0D\u662F\u55AE\u7D14\u7684\u5BB4\u6703\uFF0C\u800C\u662F\u65B0\u4E00\u8F2A\u6B0A\u529B\u89D2\u529B\u7684\u958B\u7AEF\u3002\r\n\u7B2C\u516D\u7AE0\uFF1A\u9738\u7E3D\u5BAE\u9B25\u9047\u4E0A\u5916\u661F\u4EBA\r\n\u5C31\u5728\u9CF3\u51F0\u5BAE\u7684\u9577\u5ECA\u88E1\uFF0C\u6797\u51E1\uFF08\u8F49\u751F\u7684\u9738\u9053\u7E3D\u88C1\uFF09\u624D\u525B\u7528\u51B7\u9177\u7684\u8072\u97F3\u8AAA\u51FA\uFF1A\u300C\u5F9E\u4ECA\u4EE5\u5F8C\uFF0C\u9019\u5F8C\u5BAE\u7531\u6211\u505A\u4E3B\u3002\u300D\u5FFD\u7136\u5929\u7A7A\u88C2\u958B\u4E00\u9053\u5149\u3002\r\n\u4E00\u8258\u9280\u8272\u7684\u98DB\u8239\uFF0C\u76F4\u63A5\u61F8\u6D6E\u5728\u7687\u57CE\u4E0A\u7A7A\uFF0C\u6563\u767C\u8457\u523A\u773C\u7684\u5149\u8292\u3002\u5BAE\u5973\u5011\u9A5A\u547C\uFF0C\u592A\u76E3\u5011\u8DEA\u5012\u5728\u5730\uFF0C\u9023\u5FA1\u81B3\u623F\u88E1\u525B\u716E\u597D\u7684\u71D5\u7AA9\u7CA5\u90FD\u6389\u4E86\u4E00\u5730\u3002\r\n\u300C\u9019\u2026\u2026\u662F\u5996\u8853\u55CE\uFF1F\u300D\u7687\u540E\u6342\u8457\u80F8\u53E3\uFF0C\u773C\u795E\u9A5A\u61FC\u3002\r\n\u300C\u4E0D\u662F\u5996\u8853\uFF0C\u662F\u5916\u661F\u4EBA\u3002\u300D\u6797\u51E1\u51B7\u51B7\u4E00\u7B11\uFF0C\u8A9E\u6C23\u5F77\u5F7F\u4ED6\u65E9\u5C31\u77E5\u9053\u9019\u4E00\u5929\u6703\u4F86\u3002\u4E8B\u5BE6\u4E0A\u4ED6\u771F\u7684\u77E5\u9053\u2014\u2014\u56E0\u70BA\u4ED6\u524D\u4E16\u4F5C\u70BA\u9738\u9053\u7E3D\u88C1\u7684\u6642\u5019\uFF0C\u66FE\u7D93\u6295\u8CC7\u904E\u4E00\u5BB6\u822A\u592A\u516C\u53F8\uFF0C\u9084\u53C3\u8207\u904E\u79D8\u5BC6\u7684\u661F\u969B\u4EA4\u6D41\u8A08\u756B\u3002\r\n\u98DB\u8239\u8259\u9580\u6253\u958B\uFF0C\u4E00\u7FA4\u9577\u8457\u89F8\u89D2\u7684\u85CD\u76AE\u819A\u5916\u661F\u4EBA\u8D70\u4E86\u51FA\u4F86\uFF0C\u8AAA\u8457\u7834\u788E\u7684\u6F22\u8A9E\uFF1A\u300C\u5730\u7403\u4EBA\uFF0C\u6211\u5011\u2026\u2026\u4F86\u6436\u5F8C\u5BAE\uFF01\u300D\r\n\u5168\u5834\u975C\u9ED8\u4E09\u79D2\u3002\r\n\u300C\u4F60\u5011\u4E5F\u60F3\u63D2\u624B\u5BAE\u9B25\uFF1F\u300D\u592A\u540E\u62C4\u8457\u62D0\u6756\uFF0C\u773C\u795E\u72E0\u53B2\u3002\r\n\u300C\u5C0D\uFF0C\u6211\u5011\u7684\u6BCD\u661F\u9700\u8981\u65B0\u7684\u2026\u2026\u7687\u540E\u3002\u300D\u5916\u661F\u4EBA\u9818\u8896\u5495\u5695\u4E00\u8072\uFF0C\u4F38\u51FA\u4E09\u6839\u89F8\u624B\u6307\u8457\u5728\u5834\u7684\u5983\u5B50\u5011\u3002\r\n\u9813\u6642\uFF0C\u5BAE\u5973\u5C16\u53EB\u3001\u5B2A\u5983\u660F\u53A5\uFF0C\u6EFF\u5730\u7684\u7389\u4F69\u9996\u98FE\u53EE\u53EE\u5679\u5679\u6389\u4E86\u4E00\u7247\u3002\r\n\u6797\u51E1\u5634\u89D2\u4E00\u52FE\uFF0C\u9738\u6C23\u558A\u9053\uFF1A\u300C\u54FC\uFF01\u6211\u7684\u5973\u4EBA\uFF0C\u8C48\u662F\u4F60\u5011\u80FD\u67D3\u6307\u7684\uFF01\u300D\u8AAA\u5B8C\u4ED6\u8863\u8896\u4E00\u7529\uFF0C\u5C45\u7136\u638F\u51FA\u4E00\u628A\u5916\u661F\u80FD\u91CF\u5149\u528D\u2014\u2014\u9019\u662F\u4ED6\u8F49\u751F\u6642\u7CFB\u7D71\u9001\u7684\u300C\u65B0\u624B\u5927\u79AE\u5305\u300D\u3002\r\n\u5916\u661F\u4EBA\u7ACB\u523B\u66B4\u6012\uFF0C\u958B\u555F\u8B77\u76FE\uFF0C\u96F7\u5C04\u5149\u4E82\u5C04\uFF0C\u76F4\u63A5\u628A\u5FA1\u82B1\u5712\u7684\u5047\u5C71\u70B8\u788E\u3002\u6C60\u5858\u88E1\u7684\u9326\u9BC9\u5168\u6578\u88AB\u70E4\u719F\uFF0C\u5316\u6210\u4E00\u934B\u9B5A\u6E6F\uFF0C\u9999\u5473\u77AC\u9593\u98C4\u6EFF\u5F8C\u5BAE\u3002\r\n\u300C\u554A\u554A\u554A\u2014\u2014\uFF01\u300D\u4E00\u773E\u5983\u5B50\u5687\u5F97\u4E82\u7AC4\uFF0C\u537B\u53C8\u6709\u4EBA\u5927\u558A\uFF1A\u300C\u4E0D\u884C\uFF01\u9019\u6642\u5019\u66F4\u8981\u722D\u5BF5\uFF01\u300D\u65BC\u662F\u5979\u5011\u908A\u5C16\u53EB\u908A\u6545\u610F\u6454\u5411\u6797\u51E1\u61F7\u88E1\uFF0C\u60F3\u85C9\u8457\u5371\u6A5F\u535A\u5F97\u597D\u611F\u3002\r\n\u7687\u5E1D\uFF08\u5176\u5BE6\u53EA\u662F\u500B\u5080\u5121\uFF09\u5687\u5F97\u8EB2\u5728\u9F8D\u6905\u5F8C\u9762\uFF0C\u986B\u6296\u8457\u554F\uFF1A\u300C\u6797\u611B\u537F\uFF0C\u9019\u2026\u2026\u600E\u9EBC\u8FA6\uFF1F\u300D\r\n\u6797\u51E1\u51B7\u8072\u56DE\u7B54\uFF1A\u300C\u5225\u6015\uFF0C\u6709\u6211\u5728\u3002\u300D\u7136\u5F8C\u4E00\u528D\u63EE\u51FA\uFF0C\u528D\u6C23\u885D\u5929\uFF0C\u7ADF\u7136\u628A\u5916\u661F\u98DB\u8239\u5288\u51FA\u4E00\u9053\u88C2\u7E2B\u3002\r\n\u5916\u661F\u4EBA\u9A5A\u547C\uFF1A\u300C\u4E0D\u53EF\u80FD\uFF01\u5730\u7403\u53E4\u4EE3\u4EBA\u600E\u9EBC\u6703\u6709\u9019\u7A2E\u529B\u91CF\uFF01\u300D\r\n\u300C\u56E0\u70BA\u2014\u2014\u300D\u6797\u51E1\u772F\u773C\uFF0C\u8A9E\u6C23\u51B7\u51BD\u7121\u6BD4\uFF0C\u300C\u6211\u4E0D\u53EA\u662F\u9738\u7E3D\uFF0C\u6211\u9084\u662F\u8F49\u751F\u7684\u81F3\u5C0A\u528D\u4ED9\uFF0C\u5916\u52A0\u5916\u661F\u79D1\u6280\u80A1\u6771\uFF01\u300D\r\n\u8AAA\u7F77\uFF0C\u4ED6\u4E00\u528D\u780D\u4E0B\uFF0C\u628A\u5916\u661F\u9818\u8896\u7684\u89F8\u624B\u5207\u65B7\uFF0C\u6FFA\u51FA\u85CD\u8272\u7684\u9ECF\u6DB2\u3002\u5983\u5B50\u5011\u9813\u6642\u6FC0\u52D5\u5730\u558A\uFF1A\u300C\u554A\u554A\u554A\uFF01\u597D\u5E25\uFF01\u300D\u3001\u300C\u9019\u624D\u662F\u771F\u7537\u4EBA\uFF01\u300D\u3001\u300C\u6211\u8981\u7D66\u4ED6\u751F\u4E00\u767E\u500B\u5B69\u5B50\uFF01\u300D\r\n\u592A\u540E\u4E5F\u773C\u795E\u8907\u96DC\u5730\u770B\u8457\u6797\u51E1\uFF0C\u4F4E\u8A9E\uFF1A\u300C\u6C92\u60F3\u5230\uFF0C\u5BAE\u9B25\u624D\u525B\u958B\u59CB\uFF0C\u5C31\u5DF2\u7D93\u727D\u626F\u5230\u5916\u661F\u5927\u6230\u2026\u2026\u300D\r\n\u800C\u5929\u4E0A\u7684\u88C2\u7E2B\u9084\u5728\u64F4\u5927\uFF0C\u66F4\u591A\u98DB\u8239\u958B\u59CB\u964D\u81E8\u3002\u7570\u4E16\u754C\u7684\u5BAE\u9B25\u821E\u53F0\uFF0C\u6B63\u5F0F\u5347\u7D1A\u70BA\u300C\u661F\u969B\u5BAE\u5EF7\u5927\u6DF7\u6230\u300D\u3002\r\n\u6211\u5750\u5728\u5FA1\u82B1\u5712\u7684\u5047\u5C71\u4E0A\uFF0C\u624B\u88E1\u63E1\u8457\u4E00\u628A\u53E4\u8272\u53E4\u9999\u7684\u6728\u528D\uFF0C\u5FC3\u88E1\u9ED8\u9ED8\u5410\u69FD\uFF1A\u5F9E\u524D\u4E16\u9738\u9053\u7E3D\u88C1\uFF0C\u5230\u73FE\u5728\u5BAE\u9B25\u5927\u4E82\uFF0C\u518D\u5230\u5916\u661F\u4EBA\u5165\u4FB5\uFF0C\u6211\u5230\u5E95\u662F\u4FEE\u4ED9\u4E86\u9084\u662F\u8F49\u8077\u4E86\uFF1F\r\n\u7A7A\u6C23\u88E1\u6DF7\u96DC\u8457\u8336\u8449\u86CB\u3001\u9F8D\u8766\u3001\u548C\u5916\u661F\u4EBA\u85CD\u8272\u9ECF\u6DB2\u7684\u5473\u9053\uFF0C\u56E0\u70BA\u5916\u661F\u4EBA\u7684\u9ECF\u6DB2\u88E1\u9762\u6709\u9285\u800C\u4E14\u662F\u85CD\u8272\u7684\uFF0C\u800C\u5728\u6211\u6728\u528D\u9AD8\u901F\u63EE\u52D5\u7522\u751F\u7684\u706B\u7130\u5F71\u97FF\u4E0B\u8B8A\u6210\u4E86\u767D\u8272\uFF0C\u8B93\u6211\u770B\u4E86\u6709\u9EDE\u60F3\u5410\uFF0C\u4F46\u8EAB\u70BA\u4FEE\u4ED9\u8005\uFF0C\u9023\u5410\u90FD\u5F97\u512A\u96C5\u3002\r\n\u6211\u9589\u4E0A\u773C\u775B\uFF0C\u958B\u59CB\u4FEE\u7149\u3002\r\n\u2022\t\u5438\u6C23\uFF0C\u611F\u53D7\u8840\u6DB2\u6D41\u52D5\r\n\u2022\t\u653E\u6C23\uFF0C\u611F\u53D7\u5929\u5730\u9748\u6C23\r\n\u2022\t\u63EE\u528D\uFF0C\u611F\u53D7\u9738\u7E3D\u6C23\u5834\r\n\u2022\t\u8F49\u8EAB\uFF0C\u770B\u8457\u5BAE\u9B25\u5B2A\u5983\u5011\u5C16\u53EB\u3001\u722D\u5BF5\u3001\u4E92\u76F8\u6495\u626F\r\n\u300C\u5C11\u723A\uFF01\u90A3\u500B\u8336\u8449\u86CB\u2014\u2014\uFF01\u300D\u9E97\u5B2A\u5C16\u53EB\u8457\uFF0C\u773C\u795E\u50CF\u8981\u628A\u6211\u541E\u6389\u3002\r\n\u6211\u775C\u958B\u773C\uFF0C\u624B\u4E2D\u7684\u6728\u528D\u6563\u767C\u51FA\u5FAE\u5149\uFF0C\u8F15\u8F15\u4E00\u63EE\u2014\u2014\r\n\u8336\u8449\u86CB\u77AC\u9593\u88AB\u7121\u5F62\u6C23\u5834\u5438\u5230\u6211\u9762\u524D\u3002\u5983\u5B50\u5011\u9A5A\u547C\uFF1A\u2018\u5C11\u723A\u592A\u9738\u6C23\u4E86\uFF01\u2019\r\n\u300C\u54C8\u54C8\uFF0C\u9019\u5C31\u662F\u4FEE\u4ED9\u8005\u7684\u529B\u91CF\uFF01\u300D\u6211\u5FC3\u88E1\u6697\u81EA\u5F97\u610F\uFF0C\u751A\u81F3\u60F3\u7D66\u81EA\u5DF1\u52A0\u500B\u7A31\u865F\uFF1A\u300C\u8336\u8449\u86CB\u4E4B\u795E\uFF0C\u9738\u7E3D\u4FEE\u4ED9\u81F3\u5C0A\uFF01\u300D\r\n\u5C31\u5728\u9019\u6642\uFF0C\u5916\u661F\u4EBA\u514B\u7D22\u62C9\u65AF\u964D\u843D\u5728\u5FA1\u82B1\u5712\uFF0C\u4E09\u96BB\u89F8\u624B\u6307\u8457\u6211\uFF0C\u8A9E\u6C23\u6C23\u61A4\uFF1A\r\n\u300C\u5730\u7403\u4FEE\u4ED9\u8005\uFF0C\u4F60\u7ADF\u6562\u5E72\u6D89\u6211\u5011\u7684\u8A08\u756B\uFF01\u300D\r\n\u6211\u63EE\u52D5\u6728\u528D\uFF0C\u4FEE\u4ED9\u5167\u529B\u8207\u9738\u7E3D\u6C23\u5834\u878D\u5408\uFF0C\u77AC\u9593\u5F62\u6210\u4E00\u9053\u5149\u7F69\uFF0C\u628A\u5916\u661F\u4EBA\u9707\u5F97\u5012\u9000\u4E09\u6B65\u3002\u592A\u5B50\u5728\u4E00\u65C1\u9A5A\u547C\uFF1A\u300C\u679C\u7136\u662F\u5B64\u7684\u76DF\u53CB\uFF01\u300D\r\n\u7687\u540E\u5728\u9F8D\u6905\u4E0A\u6342\u5634\u5077\u7B11\uFF1A\u300C\u9019\u5C11\u723A\u2026\u2026\u600E\u9EBC\u9023\u5916\u661F\u4EBA\u4E5F\u80FD\u6559\u8A13\uFF1F\u300D\r\n\u6211\u5FC3\u88E1\u6697\u5FD6\uFF1A\u5BAE\u9B25\u3001\u9738\u7E3D\u3001\u4FEE\u4ED9\u3001\u5916\u661F\u4EBA\u2026\u2026\u9019\u5927\u6982\u662F\u6700\u8C6A\u83EF\u7684\u8DE8\u754C\u5287\u672C\u4E86\u5427\u3002\r\n\u7136\u5F8C\uFF0C\u5983\u5B50\u5011\u958B\u59CB\u96C6\u9AD4\u8868\u6F14\u300C\u64B2\u5012\u5C11\u723A\u6C42\u5BF5\u6A21\u5F0F\u300D\uFF0C\u5C16\u53EB\u3001\u8DCC\u5012\u3001\u6293\u8863\u89D2\uFF0C\u751A\u81F3\u6709\u4EBA\u628A\u5047\u82B1\u6492\u5230\u6211\u982D\u4E0A\u3002\r\n\u6211\u5FC3\u60F3\uFF1A\u9019\u4E5F\u592A\u5EB8\u4FD7\u4E86\u5427\uFF0C\u4F46\u6211\u9084\u662F\u5F97\u4FDD\u6301\u9AD8\u51B7\u5F62\u8C61\uFF0C\u4E0D\u80FD\u7834\u529F\u3002\r\n\u65BC\u662F\uFF0C\u6211\u6DF1\u5438\u4E00\u53E3\u6C23\uFF0C\u96C6\u4E2D\u4FEE\u4ED9\u771F\u6C23\uFF0C\u624B\u6307\u8F15\u9EDE\uFF0C\u6574\u500B\u5FA1\u82B1\u5712\u77AC\u9593\u6D6E\u8D77\u4E00\u5C64\u91D1\u8272\u9748\u6C23\u7F69\u3002\r\n\u2022\t\u5983\u5B50\u5011\u8DCC\u5012\u5728\u7A7A\u4E2D\uFF0C\u50CF\u61F8\u6D6E\u5728\u7A7A\u4E2D\u7684\u82AD\u857E\u821E\u8005\r\n\u2022\t\u5916\u661F\u4EBA\u88AB\u9707\u5F97\u89F8\u624B\u6253\u7D50\uFF0C\u85CD\u8272\u9ECF\u6DB2\u6FFA\u4E86\u4E00\u5730\r\n\u2022\t\u9738\u7E3D\u7684\u80A1\u6771\u5011\u5728\u865B\u64EC\u5F71\u50CF\u88E1\u62CD\u624B\u53EB\u597D\uFF1A\u300C\u8463\u4E8B\u9577\u679C\u7136\u4E0D\u6127\u662F\u5168\u5B87\u5B99\u6700\u5F37\uFF01\u300D\r\n\u6211\u8209\u528D\u5411\u5929\u7A7A\u4E00\u6307\uFF0C\u559D\u9053\uFF1A\u300C\u8AB0\u60F3\u6436\u6211\u5973\u4EBA\u3001\u6436\u6211\u8336\u8449\u86CB\u3001\u6436\u6211\u5929\u4E0B\uFF0C\u5148\u904E\u6211\u9019\u4E00\u95DC\uFF01\u300D\r\n\u7A81\u7136\uFF0C\u5929\u969B\u4E00\u8072\u5DE8\u97FF\uFF0C\u4E00\u9846\u6D41\u661F\u7838\u4E0B\u4F86\uFF0C\u76F4\u63A5\u628A\u5FA1\u82B1\u5712\u70B8\u51FA\u4E00\u500B\u5927\u5751\uFF0C\u6C60\u5858\u88E1\u7684\u9326\u9BC9\u5168\u6578\u5316\u6210\u85CD\u8272\u9ECF\u6DB2\u2014\u2014\u5983\u5B50\u5011\u5C16\u53EB\u3001\u5916\u661F\u4EBA\u6012\u543C\u3001\u9738\u7E3D\u80A1\u6771\u5728\u96F2\u7AEF\u6703\u8B70\u88E1\u5687\u5F97\u5DEE\u9EDE\u6389\u773C\u93E1\u3002\r\n\u6211\u7AD9\u5728\u5751\u908A\uFF0C\u624B\u4E2D\u7684\u6728\u528D\u9583\u8457\u5FAE\u5149\uFF0C\u5FC3\u88E1\u9ED8\u5FF5\uFF1A\u4FEE\u4ED9\u754C\u7684\u9053\u8DEF\uFF0C\u5C31\u662F\u9019\u9EBC\u5EB8\u4FD7\u3001\u9019\u9EBC\u6DF7\u4E82\u3001\u9019\u9EBC\u9738\u6C23\u2014\u2014\u4F46\u6211\u559C\u6B61\u3002\r\n\u7136\u5F8C\u6211\u6DF1\u5438\u4E00\u53E3\u6C23\uFF0C\u628A\u8336\u8449\u86CB\u64BF\u8D77\u4F86\uFF0C\u4E00\u53E3\u541E\u4E0B\u53BB\uFF0C\u611F\u89BA\u81EA\u5DF1\u4FEE\u70BA\u66B4\u589E\u4E00\u7D1A\uFF0C\u9738\u7E3D\u6C23\u5834\u52A0\u6301\uFF0C\u518D\u52A0\u4E0A\u5916\u661F\u79D1\u6280\u52A0\u6210\u2014\u2014\r\n\u6211\u7D42\u65BC\u6210\u4E86\u2026\u2026\u5B87\u5B99\u7D1A\u9738\u7E3D\u4FEE\u4ED9\u8336\u8449\u86CB\u4E4B\u795E\u3002\r\n\r\n\u6700\u7D42\u7AE0\uFF1A\u721B\u5C3E\u5982\u98A8\r\n\u5728\u7D93\u6B77\u4E86\u8F49\u751F\u6210\u4ED9\u3001\u9738\u9053\u7E3D\u88C1\u6069\u6028\u3001\u5BAE\u5EF7\u9670\u8B00\u3001\u5916\u661F\u4EBA\u964D\u81E8\u7684\u7A2E\u7A2E\u72D7\u8840\u4E4B\u5F8C\uFF0C\u8607\u7483\u96EA\u7D42\u65BC\u7AD9\u5728\u4E86\u4E16\u754C\u7684\u6700\u4E2D\u5FC3\u3002\r\n\u300C\u6211\u7D42\u65BC\u8981\u638C\u63E1\u4E00\u5207\u4E86\uFF01\u300D\u5979\u8209\u8D77\u624B\uFF0C\u80CC\u5F8C\u662F\u9738\u9053\u7E3D\u88C1\u591C\u5BD2\u741B\u3001\u5916\u661F\u4EBA\u6307\u63EE\u5B98\u514B\u7D22\u62C9\u65AF\u3001\u9084\u6709\u4E00\u7FA4\u525B\u525B\u53DB\u8B8A\u53C8\u6295\u964D\u7684\u5F8C\u5BAE\u5B2A\u5983\u3002\r\n\u5C31\u5728\u6B64\u6642\u2014\u2014\r\n\u5929\u7A7A\u7A81\u7136\u6253\u958B\u4E86\u4E00\u500B\u5DE8\u5927\u7684\u9ED1\u6D1E\u3002\r\n\u300C\u9019\u662F\u2026\u2026\u7D42\u6975\u8003\u9A57\u55CE\uFF1F\u300D\u591C\u5BD2\u741B\u6DF1\u60C5\u53C8\u75DB\u82E6\u5730\u770B\u8457\u5979\u3002\r\n\u300C\u4E0D\uFF0C\u9019\u53EA\u662F\u4F5C\u8005\u4E0D\u60F3\u5BEB\u4E86\u3002\u300D\u8607\u7483\u96EA\u51B7\u51B7\u4E00\u7B11\u3002\r\n\u8A71\u97F3\u525B\u843D\uFF0C\u9ED1\u6D1E\u7206\u70B8\uFF0C\u6574\u500B\u4E16\u754C\u5316\u70BA\u5149\u9EDE\u3002\r\n\u6240\u6709\u89D2\u8272\u7684\u6069\u6028\u3001\u611B\u6068\u3001\u8840\u6D77\u6DF1\u4EC7\uFF0C\u5168\u90E8\u90FD\u50CF\u5783\u573E\u4E00\u6A23\u88AB\u4E00\u9375\u6E05\u9664\u3002\r\n\u5916\u661F\u4EBA\u514B\u7D22\u62C9\u65AF\u525B\u60F3\u767C\u8868\u4E00\u6BB5\u5B8F\u5049\u6F14\u8AAA\uFF0C\u7D50\u679C\u5634\u5DF4\u4E00\u5F35\uFF0C\u767C\u51FA\u4F86\u7684\u537B\u662F\u2014\u2014\r\n\u300C\u672C\u4F5C\u54C1\u5230\u6B64\u7D50\u675F\uFF0C\u8B1D\u8B1D\u6536\u770B\u3002\u300D\r\n\u65BC\u662F\uFF0C\u4ED6\u5011\u5C31\u9019\u6A23\u2026\u2026\u4EC0\u9EBC\u90FD\u6C92\u89E3\u6C7A\uFF0C\u4EC0\u9EBC\u90FD\u6C92\u4EA4\u4EE3\uFF0C\u4EC0\u9EBC\u90FD\u6C92\u514C\u73FE\u3002\r\n\u2022\t\u5973\u4E3B\u6C92\u6709\u9078\u4EFB\u4F55\u4EBA\u3002\r\n\u2022\t\u5BAE\u9B25\u6C92\u6709\u7D50\u679C\u3002\r\n\u2022\t\u5916\u661F\u4EBA\u7684\u9670\u8B00\u6C92\u4E86\u3002\r\n\u2022\t\u9738\u9053\u7E3D\u88C1\u7684\u8A93\u8A00\u88AB\u907A\u5FD8\u3002\r\n\u2022\t\u6240\u6709\u7684\u7DDA\u7D22\u5168\u90FD\u61F8\u800C\u672A\u6C7A\u3002\r\n\u6700\u5F8C\u4E00\u9801\uFF0C\u53EA\u6709\u4E00\u53E5\u8A71\uFF1A\r\n\u300C\u4E00\u5207\u90FD\u53EA\u662F\u5357\u67EF\u4E00\u5922\u3002\u300D\r\n"
