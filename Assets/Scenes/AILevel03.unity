MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 506149569}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 85bccc5c2a069794c8c1eb426abc3fee, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  scoreBoardURL: https://ai-odyssey-backend-rbzz.onrender.com/users/
  qAndAPanel: {fileID: 1068003127}
  ragPanel: {fileID: 19220060}
  chatBotPanel: {fileID: 704353921}
  initialDialogue:
    numberOfSpeakers: 2
    speakerCharacterNames:
    - "\u5192\u96AA\u8005"
    - "\u6A5F\u5668\u4EBA\u5925\u4F34"
    lines:
    - speakerIndex: 0
      speakingContent: "\u524D\u9762\u6709\u4E00\u6247\u9580\u6B38"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u7D42\u65BC\u4F86\u5230\u50B3\u8AAA\u4E2D\u7684\u9B54\u738B\u4E4B\u9580\u4E86\uFF0C\u770B\u4F86\u662F\u5FC5\u9808\u8981\u89E3\u958B\u9B54\u6CD5\u9580\u9396\u4E0A\u7684\u984C\u76EE\u624D\u80FD\u6253\u958B\u9019\u6247\u9580\u3002"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u524D\u9762\u7684\u5169\u672C\u66F8\u4F3C\u4E4E\u662F\u9B54\u738B\u6700\u559C\u6B61\u7684\u7761\u524D\u8B80\u7269\uFF0C\u9B54\u738B\u57CE\u9580\u7981\u7684\u984C\u76EE\u5C31\u662F\u5F9E\u66F8\u7C4D\u7684\u5167\u5BB9\u4F86\u51FA\u984C\u3002"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 0
      speakingContent: "\u53EF\u662F\u9019\u5169\u672C\u66F8\u597D\u539A\u5594\uFF0C\u800C\u4E14\u984C\u76EE\u770B\u8D77\u4F86\u6709\u9EDE\u96E3"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u5225\u64D4\u5FC3\uFF0C\u9019\u88E1\u6709\u5169\u53F0\u529F\u80FD\u5F37\u5927\u7684\u6A5F\u5668\u4EBA"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u77E5\u8B58\u6A5F\u5668\u4EBA\u6709\u6DF5\u535A\u7684\u77E5\u8B58\uFF0C\u53EF\u4EE5\u56DE\u7B54\u5404\u7A2E\u56F0\u96E3\u7684\u554F\u984C\uFF0C\u4F46\u662F\u4ED6\u53EF\u80FD\u6C92\u8B80\u904E\u9019\u5169\u672C\u66F8\uFF0C\u9700\u8981\u63D0\u4F9B\u984D\u5916\u7684\u8CC7\u8A0A\u7D66\u4ED6\u3002"
      showScrollContent: 1
      showImage: 1
      image: {fileID: -3613575449150048497, guid: e4b35ece2c2e5394ea80c1feaea11660, type: 3}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u6AA2\u7D22\u6A5F\u5668\u4EBA\u64C5\u9577\u641C\u7D22\uFF0C\u53EA\u8981\u8F38\u5165\u7279\u5B9A\u7684\u95DC\u9375\u5B57\uFF0C\u4ED6\u53EF\u4EE5\u5F9E\u5169\u672C\u66F8\u7684\u5167\u5BB9\u4E2D\u627E\u5230\u610F\u601D\u76F8\u95DC\u7684\u6587\u5B57\u7247\u6BB5\uFF0C\u6E1B\u5C11\u6211\u5011\u7684\u95B1\u8B80\u6642\u9593\u3002"
      showScrollContent: 1
      showImage: 1
      image: {fileID: 2824746566365799266, guid: 63efff6a523d59a45a5a264bf05a12e6, type: 3}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u6211\u5011\u53EF\u4EE5\u5148\u628A\u554F\u984C\u4E2D\u7684\u95DC\u9375\u5B57\u8F38\u5165\u7D66\u6AA2\u7D22\u6A5F\u5668\u4EBA\uFF0C\u518D\u628A\u6587\u5B57\u7247\u6BB5\u4E2D\u7684\u8CC7\u6599\u8907\u88FD\u5F8C\u8CBC\u7D66\u77E5\u8B58\u6A5F\u5668\u4EBA\uFF0C\u5C31\u53EF\u4EE5\u5F97\u5230\u554F\u984C\u7684\u7B54\u6848\u4E86\u3002"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 0
      speakingContent: "\u90A3\u6211\u5011\u958B\u59CB\u5427!\u6C92\u6642\u9593\u6D6A\u8CBB\u4E86!"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    triggerEventWhenEnding: 0
    triggeredEventIndex: 0
  endingDialogue:
    numberOfSpeakers: 1
    speakerCharacterNames:
    - "\u5192\u96AA\u8005"
    lines:
    - speakerIndex: 0
      speakingContent: "\u592A\u597D\u4E86!\u554F\u984C\u90FD\u7B54\u5C0D\u4E86\uFF0C\u6211\u5011\u8D95\u5FEB\u9032\u5165\u9B54\u738B\u57CE\u5427\u3002"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    triggerEventWhenEnding: 1
    triggeredEventIndex: 5
