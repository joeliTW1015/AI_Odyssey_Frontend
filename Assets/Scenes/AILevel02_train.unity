    - target: {fileID: 15045913467653498, guid: 206f21c683f682c49b7b8eecc73737a1, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[2].speakingContent
      value: "\u53EF\u662F\u6211\u4E0D\u592A\u6703\u5531\u6B4C\u6B38\uFF0C\u800C\u4E14\u6211\u73FE\u5728\u8981\u53BB\u5192\u96AA\uFF0C\u6539\u5929\u518D\u8AAA\u5427"
      objectReference: {fileID: 0}
    - target: {fileID: 15045913467653498, guid: 206f21c683f682c49b7b8eecc73737a1, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[3].speakingContent
      value: "\u90A3\u771F\u662F\u592A\u53EF\u60DC\u4E86\uFF0C\u6211\u9019\u88E1\u96E3\u5F97\u6709\u5BA2\u4EBA\uFF0C\u6211\u53C8\u6C92\u6709\u5176\u4ED6\u79AE\u7269\uFF0C\u5C31\u9001\u4F60\u6211\u7684\u6C34\u6C60\u88E1\u9762\u7684\u9B5A\u5427\u3002\u91E3\u7AFF\u5728\u9019\u88E1\uFF0C\u4F60\u81EA\u5DF1\u53BB\u91E3\u5427\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 15045913467653498, guid: 206f21c683f682c49b7b8eecc73737a1, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[4].speakingContent
      value: "\u6211\u7684\u6C34\u6C60\u88E1\u9762\u539F\u672C\u90FD\u662F\u9280\u9F8D\u9B5A\u7684\uFF0C\u4F46\u7531\u65BC\u758F\u65BC\u7BA1\u7406\uFF0C\u73FE\u5728\u88E1\u9762\u4E5F\u591A\u4E86\u4E0D\u5C11\u5433\u90ED\u9B5A"
