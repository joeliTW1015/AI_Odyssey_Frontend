  firstTimeEnterInitDialogue:
    numberOfSpeakers: 2
    speakerCharacterNames:
    - "\u5192\u96AA\u8005"
    - "\u6A5F\u5668\u4EBA\u5925\u4F34"
    lines:
    - speakerIndex: 0
      speakingContent: "\u9019\u88E1\u6709\u68DF\u5927\u5225\u5885\u6B38"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u6211\u5011\u53BB\u62DC\u8A2A\u4E00\u4E0B\u5225\u5885\u7684\u4E3B\u4EBA\u5427"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    triggerEventWhenEnding: 0
    triggeredEventIndex: 0
  secondTimeEnterInitDialogue:
    numberOfSpeakers: 2
    speakerCharacterNames:
    - "\u5192\u96AA\u8005"
    - "\u6A5F\u5668\u4EBA\u5925\u4F34"
    lines:
    - speakerIndex: 0
      speakingContent: "\u611F\u89BA\u9B54\u6CD5\u9B5A\u9264\u4E0D\u662F\u5F88\u6E96\u78BA"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u770B\u4F86\u662F\u8A13\u7DF4\u8CC7\u6599\u4E0D\u8DB3\u7684\u554F\u984C\uFF0C\u6211\u5011\u9700\u8981\u66F4\u591A\u7167\u7247\uFF0C\u6216\u8A31\u53BB\u554F\u554F\u770B\u9B5A\u6C60\u7684\u4E3B\u4EBA?"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    triggerEventWhenEnding: 0
    triggeredEventIndex: 0
  firstTimeFishingDialogue:
    numberOfSpeakers: 2
    speakerCharacterNames:
    - "\u5192\u96AA\u8005"
    - "\u6A5F\u5668\u4EBA\u5925\u4F34"
    lines:
    - speakerIndex: 0
      speakingContent: "\u6C60\u5858\u9019\u9EBC\u6DF1\u6839\u672C\u770B\u4E0D\u6E05\u695A\uFF0C\u8981\u600E\u9EBC\u91E3\u5230\u6B63\u78BA\u7684\u9B5A\u5462?"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u4E0D\u7528\u64D4\u5FC3\uFF0C\u85CD\u8001\u5148\u751F\u7D66\u6211\u5011\u7684\u9B5A\u9264\u662F\u9B54\u6CD5\u5F71\u50CF\u8FA8\u8B58\u9B5A\u9264\uFF0C\u53EF\u4EE5\u5728\u9B5A\u4E0A\u9264\u6642\u5224\u65B7\u91E3\u5230\u7684\u9B5A\u662F\u54EA\u7A2E\u9B5A\uFF0C\u53EA\u8981\u4E8B\u5148\u9032\u884C\u4EBA\u5DE5\u6A19\u8A18\u8A13\u7DF4\u5C31\u597D\u3002"
      showScrollContent: 1
      showImage: 1
      image: {fileID: -855298285791758126, guid: c21f89df98f2dfb46b5f9191a6b5bffe, type: 3}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u6211\u9019\u88E1\u525B\u597D\u6709\u56DB\u5F35\u9280\u9F8D\u9B5A\u6216\u5433\u90ED\u9B5A\u7684\u5716\u7247\uFF0C\u4F60\u4F86\u6A19\u8A18\u4E00\u4E0B\u9B5A\u7684\u7A2E\u985E\u5427!"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u5169\u7A2E\u9B5A\u7684\u7279\u5FB5\u5982\u4E0B\uFF1A\n\u5433\u90ED\u9B5A\uFF1A\u8EAB\u9AD4\u6A62\u5713\u800C\u5074\u6241\uFF0C\u7070\u9ED1\u6216\u7070\u7DA0\u8272\uFF0C\u8EAB\u9AD4\u6709\u689D\u7D0B\uFF0C\u80CC\u9C2D\u8207\u5C3E\u9C2D\u8F03\u5BEC\u3002\n\u9280\u9F8D\u9B5A\uFF1A\u8EAB\u9AD4\u7D30\u9577\u50CF\u5E36\u5B50\uFF0C\u9280\u767D\u8272\u5E36\u91D1\u5C6C\u5149\u6FA4\uFF0C\u80F8\u9C2D\u9577\u5982\u7FC5\u3002"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u9019\u662F\u9280\u9F8D\u9B5A"
      showScrollContent: 1
      showImage: 1
      image: {fileID: -5385838430815568311, guid: 60a749912d68bfc4680166221b541fc2, type: 3}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u9019\u662F\u5433\u90ED\u9B5A"
      showScrollContent: 1
      showImage: 1
      image: {fileID: 2045151728857558579, guid: 8d905503ac6b7064d8db9d9bf1405e55, type: 3}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u8ACB\u8FA8\u8B58\u4E26\u6A19\u8A18\u4EE5\u4E0B\u7684\u5716\u7247"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    triggerEventWhenEnding: 1
    triggeredEventIndex: 4
  secondTimeFishingDialogue:
    numberOfSpeakers: 1
    speakerCharacterNames:
    - "\u6A5F\u5668\u4EBA\u5925\u4F34"
    lines:
    - speakerIndex: 0
      speakingContent: "\u73FE\u5728\u6211\u5011\u6709\u66F4\u591A\u8CC7\u6599\u4E86\uFF0C\u518D\u4F86\u8A13\u7DF4\u4E00\u6B21\u5427"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 0
      speakingContent: "\u8A18\u5F97\uFF1A\n\u5433\u90ED\u9B5A\uFF1A\u8EAB\u9AD4\u6A62\u5713\u800C\u5074\u6241\uFF0C\u7070\u9ED1\u6216\u7070\u7DA0\u8272\uFF0C\u8EAB\u9AD4\u6709\u689D\u7D0B\uFF0C\u80CC\u9C2D\u8207\u5C3E\u9C2D\u8F03\u5BEC\u3002\n\u9280\u9F8D\u9B5A\uFF1A\u8EAB\u9AD4\u7D30\u9577\u50CF\u5E36\u5B50\uFF0C\u9280\u767D\u8272\u5E36\u91D1\u5C6C\u5149\u6FA4\uFF0C\u80F8\u9C2D\u9577\u5982\u7FC5\u3002"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 2045151728857558579, guid: 8d905503ac6b7064d8db9d9bf1405e55, type: 3}
      showText: 0
      textContent: 
    triggerEventWhenEnding: 1
    triggeredEventIndex: 4
  houseOwnerPhotoDialogue:
    numberOfSpeakers: 2
    speakerCharacterNames:
    - "\u5192\u96AA\u8005"
    - "\u85CD\u8001\u5148\u751F"
    lines:
    - speakerIndex: 0
      speakingContent: "\u8001\u5148\u751F\u60A8\u597D\u554A\uFF0C\u60F3\u8ACB\u554F\u4F60\u6709\u589E\u5F37\u9B54\u6CD5\u9B5A\u9264\u7684\u65B9\u6CD5\u55CE"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u4F60\u9019\u9EBC\u4E00\u554F\uFF0C\u6211\u7A81\u7136\u60F3\u8D77\u4F86\u6211\u4EE5\u524D\u7D66\u6211\u6C60\u5B50\u88E1\u7684\u9B5A\u62CD\u4E86\u4E00\u4E9B\u7167\u7247"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 0
      speakingContent: "??? \u904A\u6232\u7DE8\u5287\u4E5F\u592A\u61F6\u4E86\u5427?"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u53CD\u6B63\u9019\u88E1\u662F\u9470\u5319\uFF0C\u7167\u7247\u5C31\u5728\u90A3\u908A\u7684\u7BB1\u5B50\u88E1\u9762\uFF0C\u4F60\u81EA\u5DF1\u53BB\u62FF\u5427!"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    triggerEventWhenEnding: 1
    triggeredEventIndex: 5
  knowPhotoBoxDialogue:
    numberOfSpeakers: 1
    speakerCharacterNames:
    - "\u5192\u96AA\u8005"
    lines:
    - speakerIndex: 0
      speakingContent: "\u5F9E\u7BB1\u5B50\u4E2D\u7372\u5F97\u4E86\u4E00\u4E9B\u7167\u7247"
