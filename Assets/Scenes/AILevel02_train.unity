    - target: {fileID: 15045913467653498, guid: 206f21c683f682c49b7b8eecc73737a1, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[0].speakingContent
      value: "\u8001\u723A\u723A\u60A8\u597D"
      objectReference: {fileID: 0}
    - target: {fileID: 15045913467653498, guid: 206f21c683f682c49b7b8eecc73737a1, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[1].speakingContent
      value: "\u4F60\u597D\uFF0C\u975E\u5E38\u6B61\u8FCE\uFF0C\u6211\u662F\u85CD\u8001\u5148\u751F\uFF0C\u6211\u6709\u4E00\u68DF\u8D85\u5927\u7684\u5225\u5885\uFF0C\u4F60\u8981\u4E0D\u8981\u9032\u6211\u5BB6\u548C\u6211\u4E00\u8D77\u5531K\u554A?"
