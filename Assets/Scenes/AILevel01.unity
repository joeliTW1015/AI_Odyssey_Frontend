    dishRequirements: "\u9019\u9053\u83DC\u5FC5\u9808\u8981\u662F\u4E00\u76E4\u5BAE\u4FDD\u96DE\u4E01\uFF0C\u91AC\u6C41\u6FC3\u7A20\uFF0C\u8981\u6709\u82B1\u6912\u548C\u8FA3\u6912\uFF0C\u96DE\u8089\u8981\u5C0F\u584A\uFF0C\u624D\u80FD\u5165\u5473"
  - dishName: "\u7FA9\u5927\u5229\u8089\u91AC\u9EB5"
    dishRequirements: "\u9019\u9053\u6599\u7406\u5FC5\u9808\u4F7F\u7528\u7FA9\u5927\u5229\u9EB5\uFF08spaghetti\uFF09\uFF0C\u8089\u91AC\u7531\u725B\u7D5E\u8089\u8207\u756A\u8304\u70BA\u4E3B\uFF0C\u9700\u52A0\u5165\u6D0B\u8525\u3001\u5927\u849C\u3001\u80E1\u863F\u8514\u4E01\u8207\u82B9\u83DC\u672B\u62CC\u7092\u3002\u91AC\u6C41\u8981\u6FC3\u7A20\u4E14\u5747\u52FB\u88F9\u5728\u9EB5\u689D\u4E0A\uFF0C\u4E0A\u684C\u6642\u8981\u6492\u4E0A\u5E15\u746A\u68EE\u8D77\u53F8\u7C89\u3002"
  - dishName: "\u5FB7\u570B\u70E4\u8C6C\u8173"
    dishRequirements: "\u9019\u9053\u6599\u7406\u5FC5\u9808\u9078\u7528\u5E36\u76AE\u7684\u5927\u8C6C\u8173\uFF0C\u5916\u76AE\u8981\u70E4\u5230\u91D1\u9EC3\u9165\u8106\uFF0C\u8089\u8CEA\u4FDD\u6301\u8EDF\u5AE9\u591A\u6C41\u3002\u4E0A\u684C\u6642\u901A\u5E38\u642D\u914D\u9178\u83DC\uFF08sauerkraut\uFF09\u548C\u99AC\u9234\u85AF\u6CE5\u6216\u99AC\u9234\u85AF\u7403\uFF0C\u98A8\u5473\u8981\u9E79\u9999\u4E26\u5E36\u6709\u70E4\u8089\u9999\u6C23\u3002"
  CookingInterface: {fileID: 2068204476}
  dishNameText: {fileID: 417898099}
  inputField: {fileID: 1775144151}
  submitButton: {fileID: 5693944}
  quitCookingInterfaceButton: {fileID: 1450824058}
