    speakerCharacterNames:
    - "\u5192\u96AA\u8005"
    - "\u6A5F\u5668\u4EBA\u5925\u4F34"
    lines:
    - speakerIndex: 0
      speakingContent: "\u5403\u98FD\u4E86\u624D\u6709\u529B\u6C23\u7E7C\u7E8C\u5192\u96AA!
        \u6B38\u4E0D\u904E\u9019\u5BB6\u9910\u5EF3\u597D\u50CF\u9084\u6C92\u6709\u958B\u6B38"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u5947\u602A\uFF0C\u660E\u660EGoogoo Map\u4E0A\u5C31\u986F\u793A\u5DF2\u7D93\u5230\u71DF\u696D\u6642\u9593\u4E86\u3002"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 0
      speakingContent: "\u53BB\u554F\u554F\u90A3\u908A\u7684\u5E97\u54E1\u5427"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    triggerEventWhenEnding: 0
    triggeredEventIndex: 0
  endDialogue:
    numberOfSpeakers: 2
    speakerCharacterNames:
    - "\u5192\u96AA\u8005"
    - "\u9910\u5EF3\u5EDA\u5E2B"
    lines:
    - speakerIndex: 1
      speakingContent: "\u771F\u662F\u592A\u597D\u4E86\uFF0C\u4F60\u5DF2\u7D93\u5B8C\u6210\u4E86\u4ECA\u65E5\u9910\u5EF3\u7684\u4E3B\u6253\u83DC\u991A\uFF0C\u9910\u5EF3\u53EF\u4EE5\u958B\u696D\u4E86\u3002"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 1
      speakingContent: "\u6211\u770B\u4F60\u5F88\u6709\u7576\u5EDA\u5E2B\u7684\u6F5B\u529B\uFF0C\u8981\u4E0D\u8981\u4F86j\u6211\u7684\u9910\u5EF3\u62DC\u5E2B\u5B78\u85DD\u963F?"
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
    - speakerIndex: 0
      speakingContent: "\u55EF...\u6211\u60F3\u6211\u9084\u662F\u7576\u9867\u5BA2\u5C31\u597D..."
      showScrollContent: 0
      showImage: 0
      image: {fileID: 0}
      showText: 0
      textContent: 
