    - target: {fileID: 15045913467653498, guid: 206f21c683f682c49b7b8eecc73737a1, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[0].speakingContent
      value: "\u8ACB\u554F\u4F4D\u4EC0\u9EBC\u9910\u5EF3\u9084\u6C92\u958B\u59CB\u71DF\u696D\u5462?\u800C\u4E14\u6211\u767C\u73FE\u4F60\u5011\u597D\u50CF\u6839\u672C\u6C92\u6709\u5EDA\u623F?"
      objectReference: {fileID: 0}
    - target: {fileID: 15045913467653498, guid: 206f21c683f682c49b7b8eecc73737a1, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[1].speakingContent
      value: "\u6211\u662F\u9019\u9593\u9910\u5EF3\u7684\u5E6B\u624B\uFF0C\u6211\u5011\u9910\u5EF3\u4F7F\u7528\u5168\u81EA\u52D5\u9B54\u6CD5\u70F9\u8ABF\u6A5F\u4F86\u70F9\u8ABF\uFF0C\u4F46\u4E3B\u5EDA\u4E00\u76F4\u4E0D\u6EFF\u610F\u6211\u505A\u51FA\u4F86\u7684\u6599\u7406\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 15045913467653498, guid: 206f21c683f682c49b7b8eecc73737a1, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[2].speakingContent
      value: "\u6211\u5011\u9910\u5EF3\u6BCF\u5929\u90FD\u6709\u4E09\u9053\u4E3B\u6253\u6599\u7406\uFF0C\u5728\u6C92\u6709\u505A\u51FA\u4F86\u4E4B\u524D\u662F\u4E0D\u80FD\u958B\u696D\u7684\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 15045913467653498, guid: 206f21c683f682c49b7b8eecc73737a1, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[3].speakingContent
      value: "\u53EF\u662F\u6211\u771F\u7684\u597D\u9913\u963F\uFF0C\u4E0D\u7136\u6211\u5E6B\u4F60\u597D\u4E86"
      objectReference: {fileID: 0}
    - target: {fileID: 15045913467653498, guid: 206f21c683f682c49b7b8eecc73737a1, type: 3}
      propertyPath: dialogueSequence.lines.Array.data[4].speakingContent
      value: "\u771F\u7684\u55CE?\u90A3\u771F\u662F\u592A\u611F\u8B1D\u4E86\uFF0C\u76F4\u63A5\u53BB\u70F9\u98EA\u6A5F\u90A3\u908A\u8F38\u5165\u9B54\u6CD5\u6307\u4EE4\u5C31\u597D\u4E86\uFF0C\u505A\u5B8C\u4E4B\u5F8C\u53EF\u4EE5\u76F4\u63A5\u53BB\u627E\u6211\u5011\u7684\u4E3B\u5EDA\u8A55\u5206\u3002\u4E09\u9053\u6599\u7406\u90FD\u901A\u904E\u4E4B\u5F8C\u9910\u5EF3\u5C31\u80FD\u958B\u5F35\u5566!"
      objectReference: {fileID: 0}
    - target: {fileID: 15045913467653498, guid: 206f21c683f682c49b7b8eecc73737a1, type: 3}
